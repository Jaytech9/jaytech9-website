{
  "name": "jaytech9-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "build": "tsc -b && vite build",
    "check": "tsc -b && tsc -p functions/tsconfig.json",
    "db:local": "wrangler d1 execute jaytech9 --local --persist-to ../.wrangler/state --file=../database/schema.sql",
    "dev:api": "vite build && wrangler pages dev dist --port 8788 --persist-to ../.wrangler/state",
    "deploy:scheduler": "wrangler deploy --config workers/scheduler/wrangler.toml",
    "lint": "eslint .",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "jose": "^6.2.17",
    "mediabunny": "^1.66.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@eslint/js": "^9.25.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "wrangler": "^4.161.0"
  }
}
