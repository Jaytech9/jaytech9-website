---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | JayTech9" description="This page doesn't exist.">
  <section class="section">
    <div class="wrap not-found">
      <h1>This page doesn’t exist</h1>
      <p class="lede">The link may be old, or the address may have a typo. Try one of these instead.</p>
      <div class="button-row">
        <a class="button" href="/">
          Go to the home page
        </a>
        <a class="button button--quiet" href="/contact/">
          Contact us
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found .lede {
    margin-block: 1.5rem 2.25rem;
  }
</style>
