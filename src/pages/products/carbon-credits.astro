---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import CaseAside from '../../components/CaseAside.astro';
import Testimonials from '../../components/Testimonials.astro';
---

<Base
  title="Carbon credits for smallholder farmers | JayTech9"
  description="Helping smallholder farmers who use sustainable methods find out whether they qualify for carbon credits, and earn from it if they do."
  ogType="article"
>
  <article>
    <header class="page-head">
      <div class="wrap">
        <p class="crumb">
          <a href="/products/">Products</a>
        </p>
        <h1>Carbon credits for smallholder farmers</h1>
        <p class="lede">
          Helping smallholder farmers who use sustainable methods find out whether they qualify for carbon
          credits, and <em class="hl">earn from it</em> if they do.
        </p>
      </div>
    </header>
    <div class="wrap overlap">
        <dl class="facts facts-card">
          <div>
            <dt>Client</dt>
            <dd>AgriTech initiative</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>
              <span class="status" data-status="In development">
                In development
              </span>
            </dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>2026</dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>Field data collection, Data analysis</dd>
          </div>
        </dl>
    </div>
    <div class="wrap section case-body">
      <div class="prose">
        <h2 id="why-it-matters">Why it matters</h2>
        <p>
          Many smallholder farmers already practise methods that keep carbon in the soil, such as reduced
          tillage, cover crops and agroforestry. They rarely see any income from it, because proving it takes
          records and data they don’t have.
        </p>
        <h2 id="what-were-doing">What we’re doing</h2>
        <ul>
          <li>
            <strong>Collecting field data</strong> on farm practices using mobile forms that work in rural
            areas.
          </li>
          <li>
            <strong>Checking eligibility</strong> against carbon credit programme requirements.
          </li>
          <li>
            <strong>Keeping clear records</strong> that farmers and programme partners can trust.
          </li>
        </ul>
        <p>
          This work builds on years of training farmers in sustainable and regenerative agriculture in the
          field.
        </p>
      </div>
      <CaseAside id="carbon-credits" />
    </div>
  </article>
  <Testimonials heading="What the client says" product="carbon-credits" limit={1} />
  <nav class="wrap next" aria-label="Next project">
    <p class="muted">Next project</p>
    <a href="/products/logalyzer/">Logalyzer</a>
  </nav>
  <CtaBand
    heading="Need something like this?"
    highlight="Let’s build yours."
    text=""
  />
</Base>

<style>
  .crumb {
    font-size: var(--step--1);
    margin-bottom: 1rem;
  }
  .page-head h1 {
    max-width: 20ch;
  }
  .facts {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    gap: 1rem 2rem;
    margin: 0;
    display: grid;
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .facts dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }
  .facts .status {
    color: var(--ink);
    font-size: var(--step-0);
  }
  .case-body {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  @media (width >= 56rem) {
    .case-body {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    }
  }
  .next {
    padding-bottom: 0.5rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .next a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    color: var(--ink);
    margin-top: 0.25rem;
    text-decoration: none;
    display: inline-block;
  }
  .next a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
</style>
