---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import CaseAside from '../../components/CaseAside.astro';
import Testimonials from '../../components/Testimonials.astro';
---

<Base
  title="Donation management system | JayTech9"
  description="Online giving through Paystack, with a private dashboard that shows who gave, how much and when."
  ogType="article"
>
  <article>
    <header class="page-head">
      <div class="wrap">
        <p class="crumb">
          <a href="/products/">Products</a>
        </p>
        <h1>Donation management system</h1>
        <p class="lede">
          Online giving through Paystack, with a private dashboard that shows who gave, how much and when.
        </p>
      </div>
    </header>
    <div class="wrap overlap">
        <dl class="facts facts-card">
          <div>
            <dt>Client</dt>
            <dd>A Ghanaian nonprofit</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>
              <span class="status" data-status="Delivered">
                Delivered
              </span>
            </dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>2026</dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>PHP, MySQL, Paystack, Chart.js</dd>
          </div>
        </dl>
    </div>
    <div class="wrap section case-body">
      <div class="prose">
        <h2 id="the-problem">The problem</h2>
        <p>
          Donations arrived through mobile money, bank transfers and cash, and were tracked in a spreadsheet.
          Thanking donors and reporting to the board meant hours of copying figures by hand.
        </p>
        <h2 id="what-we-built">What we built</h2>
        <ul>
          <li>
            <strong>A giving page</strong> where supporters pay with mobile money or card through Paystack.
          </li>
          <li>
            <strong>A secure admin dashboard</strong> with sign-in, showing totals, trends over time and top
            donors as charts.
          </li>
          <li>
            <strong>One-click CSV export</strong>, so the finance team can take the numbers straight into
            their reports.
          </li>
        </ul>
        <h2 id="the-result">The result</h2>
        <p>
          Staff now see every donation as it arrives, and preparing a donor report takes minutes instead of an
          afternoon.
        </p>
      </div>
      <CaseAside id="donation-management" />
    </div>
  </article>
  <Testimonials heading="What the client says" product="donation-management" limit={1} />
  <nav class="wrap next" aria-label="Next project">
    <p class="muted">Next project</p>
    <a href="/products/field-reporting-dashboard/">Field reporting dashboard</a>
  </nav>
  <CtaBand
    heading="Tell us what slows your business down"
    text="Book a free 30-minute call. We’ll listen, then send a clear quote."
  />
</Base>

<style>
  .crumb {
    font-size: var(--step--1);
    margin-bottom: 1rem;
  }
  .page-head h1 {
    max-width: 20ch;
  }
  .facts {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    gap: 1rem 2rem;
    margin: 0;
    display: grid;
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .facts dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }
  .facts .status {
    color: var(--ink);
    font-size: var(--step-0);
  }
  .case-body {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  @media (width >= 56rem) {
    .case-body {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    }
  }
  .next {
    padding-bottom: 0.5rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .next a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    color: var(--ink);
    margin-top: 0.25rem;
    text-decoration: none;
    display: inline-block;
  }
  .next a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
</style>
