---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import CaseAside from '../../components/CaseAside.astro';
import Testimonials from '../../components/Testimonials.astro';
---

<Base
  title="Logalyzer | JayTech9"
  description="A free browser tool that reads server log files and highlights errors, warnings and patterns in seconds."
  ogType="article"
>
  <article>
    <header class="page-head">
      <div class="wrap">
        <p class="crumb">
          <a href="/products/">Products</a>
        </p>
        <h1>Logalyzer</h1>
        <p class="lede">
          A free browser tool that reads server log files and highlights errors, warnings and patterns in
          seconds.
        </p>
        <a class="button" href="https://jaytech9.github.io/Logalyzer/">
          Open Logalyzer
        </a>
      </div>
    </header>
    <div class="wrap overlap">
        <dl class="facts facts-card">
          <div>
            <dt>Client</dt>
            <dd>Open-source tool</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>
              <span class="status" data-status="Live">
                Live
              </span>
            </dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>2025</dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>JavaScript, HTML, CSS</dd>
          </div>
        </dl>
    </div>
    <div class="wrap section case-body">
      <div class="prose">
        <h2 id="what-it-does">What it does</h2>
        <p>
          Drop a log file into the page and Logalyzer sorts every line by severity, counts errors and
          warnings, and shows the patterns that repeat most. Everything runs in the browser, so log files
          never leave your computer.
        </p>
      </div>
      <CaseAside id="logalyzer" />
    </div>
  </article>
  <Testimonials heading="What the client says" product="logalyzer" limit={1} />
  <nav class="wrap next" aria-label="Next project">
    <p class="muted">Next project</p>
    <a href="/products/buildsmart/">BuildSmart</a>
  </nav>
  <CtaBand
    heading="Tell us what slows your business down"
    text="Book a free 30-minute call. We’ll listen, then send a clear quote."
  />
</Base>

<style>
  .crumb {
    font-size: var(--step--1);
    margin-bottom: 1rem;
  }
  .page-head h1 {
    max-width: 20ch;
  }
  .facts {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    gap: 1rem 2rem;
    margin: 0;
    display: grid;
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .facts dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }
  .facts .status {
    color: var(--ink);
    font-size: var(--step-0);
  }
  .case-body {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  @media (width >= 56rem) {
    .case-body {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    }
  }
  .next {
    padding-bottom: 0.5rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .next a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    color: var(--ink);
    margin-top: 0.25rem;
    text-decoration: none;
    display: inline-block;
  }
  .next a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
</style>
