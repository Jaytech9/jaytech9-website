---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import CaseAside from '../../components/CaseAside.astro';
import Testimonials from '../../components/Testimonials.astro';
---

<Base
  title="Website and CRM | JayTech9"
  description="A portfolio website the team can update themselves, linked to a simple CRM for tracking enquiries, calls, emails and visits."
  ogType="article"
>
  <article>
    <header class="page-head">
      <div class="wrap">
        <p class="crumb">
          <a href="/products/">Products</a>
        </p>
        <h1>Website and CRM</h1>
        <p class="lede">
          A portfolio website the team can update themselves, linked to a <em class="hl">simple CRM</em> for tracking enquiries,
          calls, emails and visits.
        </p>
      </div>
    </header>
    <div class="wrap overlap">
        <dl class="facts facts-card">
          <div>
            <dt>Client</dt>
            <dd>A creative media agency in Accra</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>
              <span class="status" data-status="In progress">
                In progress
              </span>
            </dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>2026</dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>PHP, MySQL</dd>
          </div>
        </dl>
    </div>
    <div class="wrap section case-body">
      <div class="prose">
        <h2 id="the-problem">The problem</h2>
        <p>
          Enquiries came in by phone, email, social media and walk-ins, and there was no single record of who
          had been contacted or followed up.
        </p>
        <h2 id="what-were-building">What we’re building</h2>
        <ul>
          <li>
            <strong>A public website</strong> showing the agency’s past work, with an enquiry form and social
            links. Staff can add new projects without a developer.
          </li>
          <li>
            <strong>A CRM</strong> where the secretary logs every new contact, and the manager can see calls,
            emails and visits for each client and what needs following up.
          </li>
          <li>
            <strong>Hosting and maintenance</strong> handled by JayTech9 for the first year.
          </li>
        </ul>
      </div>
      <CaseAside id="agency-website-crm" />
    </div>
  </article>
  <Testimonials heading="What the client says" product="agency-website-crm" limit={1} />
  <nav class="wrap next" aria-label="Next project">
    <p class="muted">Next project</p>
    <a href="/products/green-hatch-investments/">Green Hatch Investments website</a>
  </nav>
  <CtaBand
    heading="Need something like this?"
    highlight="Let’s build yours."
    text=""
  />
</Base>

<style>
  .crumb {
    font-size: var(--step--1);
    margin-bottom: 1rem;
  }
  .page-head h1 {
    max-width: 20ch;
  }
  .facts {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    gap: 1rem 2rem;
    margin: 0;
    display: grid;
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .facts dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }
  .facts .status {
    color: var(--ink);
    font-size: var(--step-0);
  }
  .case-body {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  @media (width >= 56rem) {
    .case-body {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    }
  }
  .next {
    padding-bottom: 0.5rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .next a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    color: var(--ink);
    margin-top: 0.25rem;
    text-decoration: none;
    display: inline-block;
  }
  .next a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
</style>
