---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

// About header background: photos from our field work. Each photo shows for
// a few seconds with a slow zoom. `pos` picks which part of the photo stays in view.
const slides = [
  { src: '/images/about/maize-field.webp', pos: 'center 60%' },
  { src: '/images/about/nursery.webp', pos: 'center 55%' },
  { src: '/images/about/field-visit.webp', pos: 'center 45%' },
  { src: '/images/about/grain-store.webp', pos: 'center 40%' },
  { src: '/images/about/farm-road.webp', pos: 'center 45%' },
];

const principles = [
  { icon: 'search', title: 'Start with the real problem', text: 'We ask how the work is done today before suggesting any software. Sometimes the answer is a better spreadsheet, and we’ll say so.' },
  { icon: 'globe', title: 'Built for real-world conditions', text: 'Fast on mobile data, mobile money and local taxes built in, and screens that make sense to staff who aren’t technical.' },
  { icon: 'key', title: 'You own what you pay for', text: 'Your domain is in your name, your data stays yours, and you receive the code and logins at handover.' },
  { icon: 'message', title: 'Plain answers', text: 'Clear quotes in your currency, honest timelines and no jargon. If something will cost more or take longer, you hear it from us first.' },
];

const skills = [
  { icon: 'monitor', label: 'Web and software development' },
  { icon: 'chart', label: 'Data analytics and reporting' },
  { icon: 'cpu', label: 'AI and automation' },
  { icon: 'lock', label: 'Networking and IT security' },
  { icon: 'sprout', label: 'Sustainable agriculture' },
  { icon: 'brush', label: 'Brand and print design' },
];

import { site } from '../data/site';
---

<Base
  title="About | JayTech9"
  description="JayTech9 is an Accra-based technology company building websites, business systems, data dashboards and AgriTech tools for businesses, nonprofits and farmers in Ghana and around the world."
>
  <header class="page-head about-hero">
    <div class="about-hero__media" aria-hidden="true">
      {
        slides.map((s, i) => (
          <img
            class:list={['about-hero__slide', { 'is-active': i === 0 }]}
            src={i === 0 ? s.src : undefined}
            data-src={s.src}
            alt=""
            decoding="async"
            fetchpriority={i === 0 ? 'high' : undefined}
            style={`--pos: ${s.pos}`}
          />
        ))
      }
    </div>
    <div class="wrap about-hero__content">
      <h1>Technology that fits how your business works</h1>
    </div>
    <button type="button" class="about-hero__pause" aria-label="Pause background slideshow" hidden>
      <svg class="i-pause" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><rect x="2" y="1" width="3" height="10" rx="1" /><rect x="7" y="1" width="3" height="10" rx="1" /></svg>
      <svg class="i-play" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z" /></svg>
    </button>
  </header>
  <section class="section">
    <div class="wrap overlap sheet storyB">
      <div class="storyB__text">
        <h2>Our story</h2>
        <p>JayTech9 grew out of agricultural field work. Training smallholder farmers and running cereal quality checks meant long days of paperwork: the same figures copied into forms and notebooks, again and again.</p>
        <p>Automating that work led to building tools for others with the same problem. Today we build websites, business systems and data dashboards for clients in Ghana and abroad, and BuildSmart, our own software for building material businesses.</p>
      </div>
      <div class="storyB__logo">
        <Image src={logo} alt="JayTech9 logo" width={320} height={320} />
      </div>
    </div>
  </section>
  <section class="section section--band" aria-labelledby="principles-heading">
    <div class="wrap">
      <div class="center-head">
        <h2 id="principles-heading">How we work</h2>
        <p>Four promises we keep on every project, from a one-page website to a full business system.</p>
      </div>
      <ul class="feature-grid">
        {principles.map((pr) => (
          <li class="card feature">
            <span class="feature__icon"><Icon name={pr.icon as any} size={28} strokeWidth={1.6} /></span>
            <h3>{pr.title}</h3>
            <p>{pr.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section" aria-labelledby="expertise-heading">
    <div class="wrap">
      <div class="center-head">
        <h2 id="expertise-heading">What we bring</h2>
        <p>Skills across software, data and agriculture, backed by training in ICT, data analytics, AI and networking.</p>
      </div>
      <ul class="skill-grid">
        {skills.map((k) => (
          <li class="card skill">
            <span class="skill__icon"><Icon name={k.icon as any} size={30} strokeWidth={1.5} /></span>
            <span class="skill__label">{k.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  // Background slideshow for the About header: each photo shows for 6 seconds with a slow zoom,
  // then fades to the next. Respects reduced motion and data saver, and has a pause button
  // (needed for anything that moves for more than five seconds).
  const hero = document.querySelector<HTMLElement>('.about-hero');
  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLImageElement>('.about-hero__slide'));
    const pauseBtn = hero.querySelector<HTMLButtonElement>('.about-hero__pause')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as any).connection?.saveData;
    let current = 0;
    let timer = 0;
    let paused = false;

    const loadImages = () =>
      slides.forEach((s) => {
        if (!s.getAttribute('src') && s.dataset.src) s.src = s.dataset.src;
      });

    function show(i: number) {
      const prev = slides[current];
      current = (i + slides.length) % slides.length;
      const next = slides[current];
      if (prev !== next) {
        prev.classList.remove('is-active');
        next.classList.remove('is-active');
        void next.offsetWidth; // restart the zoom
        next.classList.add('is-active');
      }
      clearTimeout(timer);
      if (!paused) timer = window.setTimeout(() => show(current + 1), 6000);
    }

    if (!reduce && !saveData && slides.length > 1) {
      pauseBtn.hidden = false;
      // Load the other photos once the page has settled, so the first view stays fast.
      if (document.readyState === 'complete') loadImages();
      else addEventListener('load', loadImages, { once: true });
      show(0);
      pauseBtn.addEventListener('click', () => {
        paused = !paused;
        pauseBtn.classList.toggle('is-paused', paused);
        hero.classList.toggle('is-paused', paused);
        pauseBtn.setAttribute('aria-label', paused ? 'Play background slideshow' : 'Pause background slideshow');
        if (paused) clearTimeout(timer);
        else show(current + 1);
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) clearTimeout(timer);
        else if (!paused) show(current);
      });
    }
  }
</script>

<style>
  /* ---------- Header: field photos behind the title ----------
     A dark brand-blue overlay keeps the pictures quiet so the words lead. */
  .about-hero {
    isolation: isolate;
    min-height: clamp(24rem, 62vh, 36rem);
    display: flex;
    align-items: center;
    padding-top: clamp(3rem, 8vw, 6rem);
    background: #06223a;
  }
  .about-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .about-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 50% 45%, #04182bd9 0%, #06264ab3 55%, #06264a8c 100%),
      linear-gradient(to top, #06223a 0%, #06223a00 45%);
  }
  .about-hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, center);
    opacity: 0;
    transition: opacity 1.6s ease;
  }
  .about-hero__slide.is-active {
    opacity: 1;
  }
  img.about-hero__slide.is-active {
    animation: hero-zoom 7.5s ease-out both;
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }
  .about-hero__content {
    position: relative;
  }
  .about-hero__eyebrow {
    display: inline-block;
    margin: 0 0 1rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: #ffffff1f;
    border: 1px solid #ffffff33;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--white);
    backdrop-filter: blur(6px);
  }
  /* Title centred in the visible part of the header, above the card. */
  .about-hero__content {
    text-align: center;
  }
  .about-hero h1 {
    max-width: 18ch;
    margin: 0 auto;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--white);
    text-wrap: balance;
    text-shadow: 0 2px 24px #0006;
  }
  .about-hero__lede {
    max-width: 34rem;
    margin: 1.1rem 0 0;
    font-size: var(--step-1);
    line-height: 1.5;
    color: #d9e8f2;
    text-wrap: pretty;
  }
  .about-hero__pause {
    position: absolute;
    z-index: 2;
    right: max(var(--gutter), calc((100% - var(--wrap)) / 2));
    bottom: calc(var(--overlap) + 1rem);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid #ffffff40;
    background: #ffffff1a;
    color: var(--white);
    cursor: pointer;
    backdrop-filter: blur(6px);
  }
  .about-hero__pause:hover {
    background: #ffffff33;
  }
  .about-hero__pause:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .about-hero__pause svg {
    fill: currentColor;
  }
  .about-hero__pause .i-play,
  .about-hero__pause.is-paused .i-pause {
    display: none;
  }
  .about-hero__pause.is-paused .i-play {
    display: block;
  }
  .about-hero.is-paused img.about-hero__slide.is-active {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .about-hero__slide {
      transition: none;
    }
    img.about-hero__slide.is-active {
      animation: none;
    }
  }

  .principles {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .facts {
    gap: 2rem 5rem;
    display: grid;
  }
  .facts h2 {
    margin-bottom: 1rem;
  }
  .facts p {
    max-width: 40ch;
  }
  .expertise {
    border-top: 2px solid var(--ink);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .expertise li {
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    padding-block: 0.9rem;
  }
  .team {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 2.5rem 2rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .team__photo,
  .team__initials {
    aspect-ratio: 1;
    border-radius: var(--radius);
    width: 100%;
    max-width: 100%;
    margin-bottom: 1rem;
  }
  .team__photo {
    object-fit: cover;
  }
  .team__initials {
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    place-items: center;
    display: grid;
  }
  .team__role {
    color: var(--green-deep);
    font-size: var(--step--1);
    margin-top: 0.2rem;
  }
  .team__bio {
    color: var(--ink-soft);
    font-size: var(--step--1);
    margin-top: 0.6rem;
  }
  .team__join {
    margin-top: 2.5rem;
  }
  @media (width>=52rem) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* ---------- Centred sections in the style of the reference ---------- */
  .center-head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto clamp(2rem, 5vw, 3rem);
  }
  .center-head h2 {
    font-size: var(--step-3);
  }
  .center-head p {
    color: var(--ink-soft);
    margin-top: 0.85rem;
  }
  /* How we work */
  .feature-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .feature {
    text-align: center;
    align-items: center;
    gap: 0.75rem;
    padding: clamp(1.75rem, 3vw, 2.25rem) clamp(1.25rem, 2.5vw, 1.75rem);
    transition:
      box-shadow 0.25s var(--card-ease),
      border-color 0.25s;
    border-bottom: 3px solid transparent;
  }
  .feature:hover {
    box-shadow: var(--shadow-card-hover);
    border-bottom-color: var(--brand);
  }
  .feature__icon {
    color: var(--brand);
    background: radial-gradient(circle at 30% 30%, #e8f3fa, #d6e9f6);
    border-radius: 50%;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    margin-bottom: 0.4rem;
    display: grid;
    position: relative;
  }
  .feature__icon:after {
    content: '';
    background: var(--accent);
    border-radius: 50%;
    width: 0.6rem;
    height: 0.6rem;
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
  }
  .feature h3 {
    font-size: var(--step-1);
  }
  .feature p {
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  /* What we bring */
  .skill-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
    max-width: 58rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .skill {
    text-align: center;
    justify-content: center;
    align-items: center;
    gap: 0.7rem;
    min-height: 9.5rem;
    padding: 1.25rem 0.75rem;
    transition:
      box-shadow 0.25s var(--card-ease),
      border-color 0.25s;
    border-bottom: 3px solid transparent;
  }
  .skill:hover {
    box-shadow: var(--shadow-card-hover);
    border-bottom-color: var(--accent-deep);
  }
  .skill__icon {
    color: var(--brand);
  }
  .skill__label {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }
  @media (width>=48rem) {
    .skill-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .storyB { display: grid; gap: 2rem 3.5rem; align-items: center; padding: clamp(1.5rem, 4vw, 3rem); }
  @media (width >= 52rem) { .storyB { grid-template-columns: 1.2fr 1fr; } }
  .storyB__text h2 { margin: 0 0 1rem; }
  .storyB__text p { color: var(--ink-soft); line-height: 1.65; max-width: 36rem; margin: 0 0 1rem; }
  /* JayTech9 logo beside the story, on a soft brand glow, floating gently. */
  .storyB__logo {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 2rem);
  }
  .storyB__logo::before {
    content: '';
    position: absolute;
    width: min(100%, 20rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, #6fd04a2e, #0068a11f 60%, transparent);
  }
  .storyB__logo img {
    position: relative;
    width: min(70%, 15rem);
    height: auto;
    filter: drop-shadow(0 18px 30px #00507c33);
  }
  @media (prefers-reduced-motion: no-preference) {
    .storyB__logo img {
      animation: logo-float 6s ease-in-out infinite;
    }
  }
  @keyframes logo-float {
    50% {
      transform: translateY(-8px);
    }
  }
</style>
