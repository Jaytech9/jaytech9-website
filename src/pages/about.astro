---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const principles = [
  { icon: 'search', title: 'Start with the real problem', text: 'We ask how the work is done today before suggesting any software. Sometimes the answer is a better spreadsheet, and we’ll say so.' },
  { icon: 'globe', title: 'Built for real-world conditions', text: 'Fast on mobile data, mobile money and local taxes built in, and screens that make sense to staff who aren’t technical.' },
  { icon: 'key', title: 'You own what you pay for', text: 'Your domain is in your name, your data stays yours, and you receive the code and logins at handover.' },
  { icon: 'message', title: 'Plain answers', text: 'Clear quotes in your currency, honest timelines and no jargon. If something will cost more or take longer, you hear it from us first.' },
];

const skills = [
  { icon: 'monitor', label: 'Web and software development' },
  { icon: 'chart', label: 'Data analytics and reporting' },
  { icon: 'cpu', label: 'AI and automation' },
  { icon: 'lock', label: 'Networking and IT security' },
  { icon: 'sprout', label: 'Sustainable agriculture' },
  { icon: 'brush', label: 'Brand and print design' },
];

import { site } from '../data/site';
---

<Base
  title="About | JayTech9"
  description="JayTech9 is an Accra-based technology company building websites, business systems, data dashboards and AgriTech tools for businesses, nonprofits and farmers in Ghana and around the world."
>
  <header class="page-head about-head">
    <svg class="about-head__shape" viewBox="-200 -320 660 640" aria-hidden="true" focusable="false">
      <defs>
        <mask id="puzzle-gap" maskUnits="userSpaceOnUse" x="-200" y="-320" width="660" height="640">
          <rect x="-200" y="-320" width="660" height="640" fill="#fff" />
          <g fill="#000" stroke="#000" stroke-width="22" stroke-linejoin="round">
            <path d="M0 -150.0 L150.0 0 L0 150.0 L-150.0 0 Z" /><circle cx="87.7" cy="-87.7" r="34"/><circle cx="87.7" cy="87.7" r="34"/><circle cx="-87.7" cy="87.7" r="34"/><circle cx="-87.7" cy="-87.7" r="34"/>
          </g>
        </mask>
      </defs>
      <g mask="url(#puzzle-gap)" class="pz-set">
        <path class="pz pz--blue" style="--i:1" d="M150 -291.0 L291.0 -150 L150 -9.0 L9.0 -150 Z" />
        <path class="pz pz--green" style="--i:2" d="M300 -141.0 L441.0 0 L300 141.0 L159.0 0 Z" />
        <path class="pz pz--red" style="--i:3" d="M150 9.0 L291.0 150 L150 291.0 L9.0 150 Z" />
      </g>
      <g class="pz pz--yellow">
        <path d="M0 -150.0 L150.0 0 L0 150.0 L-150.0 0 Z" /><circle cx="87.7" cy="-87.7" r="34"/><circle cx="87.7" cy="87.7" r="34"/><circle cx="-87.7" cy="87.7" r="34"/><circle cx="-87.7" cy="-87.7" r="34"/>
      </g>
    </svg>
    <div class="wrap">
      <h1>Technology that fits how your business works</h1>
    </div>
  </header>
  <section class="section">
    <div class="wrap overlap sheet storyB">
      <div class="storyB__text">
        <h2>Our story</h2>
        <p>JayTech9 grew out of agricultural field work. Training smallholder farmers and running cereal quality checks meant long days of paperwork: the same figures copied into forms and notebooks, again and again.</p>
        <p>Automating that work led to building tools for others with the same problem. Today we build websites, business systems and data dashboards for clients in Ghana and abroad, and BuildSmart, our own software for building material businesses.</p>
      </div>
      <div class="storyB__panel">
        <p class="storyB__title">What we replace</p>
        <ul>
          <li><span class="storyB__from">Exercise books</span><span class="storyB__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span><span class="storyB__to">Stock and sales system</span></li>
          <li><span class="storyB__from">Counting cash by hand</span><span class="storyB__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span><span class="storyB__to">Donation dashboard</span></li>
          <li><span class="storyB__from">WhatsApp reports</span><span class="storyB__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span><span class="storyB__to">Live field dashboard</span></li>
          <li><span class="storyB__from">Paper forms</span><span class="storyB__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span><span class="storyB__to">Mobile-friendly web app</span></li>
        </ul>
      </div>
    </div>
  </section>
  <section class="section section--band" aria-labelledby="principles-heading">
    <div class="wrap">
      <div class="center-head">
        <h2 id="principles-heading">How we work</h2>
        <p>Four promises we keep on every project, from a one-page website to a full business system.</p>
      </div>
      <ul class="feature-grid">
        {principles.map((pr) => (
          <li class="card feature">
            <span class="feature__icon"><Icon name={pr.icon as any} size={28} strokeWidth={1.6} /></span>
            <h3>{pr.title}</h3>
            <p>{pr.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section" aria-labelledby="expertise-heading">
    <div class="wrap">
      <div class="center-head">
        <h2 id="expertise-heading">What we bring</h2>
        <p>Skills across software, data and agriculture, backed by training in ICT, data analytics, AI and networking.</p>
      </div>
      <ul class="skill-grid">
        {skills.map((k) => (
          <li class="card skill">
            <span class="skill__icon"><Icon name={k.icon as any} size={30} strokeWidth={1.5} /></span>
            <span class="skill__label">{k.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Puzzle shape: its right edge lines up with the card's right edge, and on wider screens it
     rests on the card's top edge (tucked just behind it). Vector, so every piece is complete. */
  .about-head {
    --edge: max(var(--gutter), calc((100% - var(--wrap)) / 2));
  }
  .about-head__shape {
    pointer-events: none;
    width: 8.5rem;
    height: auto;
    position: absolute;
    top: 0.75rem;
    right: var(--edge);
    overflow: visible;
  }
  .pz--yellow {
    fill: #fdc85a;
  }
  .pz--blue {
    fill: #4ab0e4;
  }
  .pz--green {
    fill: #a2e45a;
  }
  .pz--red {
    fill: #eb4e2b;
  }
  .about-head .wrap > h1 {
    padding-right: 7.5rem;
  }
  @media (width>=48rem) {
    .about-head__shape {
      width: clamp(13rem, 6rem + 12vw, 19rem);
      top: auto;
      bottom: calc(var(--overlap) - 1.25rem);
    }
    .about-head .wrap > h1 {
      padding-right: 0;
    }
    .about-head .wrap > :is(h1, .lede) {
      max-width: min(40rem, calc(100% - 17rem));
    }
  }
  /* Small animation: pieces slide together on load, then the yellow piece gently bobs in place. */
  .pz-set .pz,
  .pz--yellow {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pz-set .pz {
      animation: pz-in 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 0.12s) both;
    }
    .pz--yellow {
      animation:
        pz-yellow-in 0.9s cubic-bezier(0.2, 0.9, 0.3, 1.2) 0.5s both,
        pz-bob 4.5s ease-in-out 1.6s infinite;
    }
  }
  @keyframes pz-in {
    from {
      opacity: 0;
      translate: 24px -16px;
    }
  }
  @keyframes pz-yellow-in {
    from {
      opacity: 0;
      translate: -36px 0;
      rotate: -8deg;
    }
  }
  @keyframes pz-bob {
    50% {
      translate: -5px 4px;
      rotate: -2deg;
    }
  }

  .principles {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .facts {
    gap: 2rem 5rem;
    display: grid;
  }
  .facts h2 {
    margin-bottom: 1rem;
  }
  .facts p {
    max-width: 40ch;
  }
  .expertise {
    border-top: 2px solid var(--ink);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .expertise li {
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    padding-block: 0.9rem;
  }
  .team {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 2.5rem 2rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .team__photo,
  .team__initials {
    aspect-ratio: 1;
    border-radius: var(--radius);
    width: 100%;
    max-width: 100%;
    margin-bottom: 1rem;
  }
  .team__photo {
    object-fit: cover;
  }
  .team__initials {
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    place-items: center;
    display: grid;
  }
  .team__role {
    color: var(--green-deep);
    font-size: var(--step--1);
    margin-top: 0.2rem;
  }
  .team__bio {
    color: var(--ink-soft);
    font-size: var(--step--1);
    margin-top: 0.6rem;
  }
  .team__join {
    margin-top: 2.5rem;
  }
  @media (width>=52rem) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* ---------- Centred sections in the style of the reference ---------- */
  .center-head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto clamp(2rem, 5vw, 3rem);
  }
  .center-head h2 {
    font-size: var(--step-3);
  }
  .center-head p {
    color: var(--ink-soft);
    margin-top: 0.85rem;
  }
  /* How we work */
  .feature-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .feature {
    text-align: center;
    align-items: center;
    gap: 0.75rem;
    padding: clamp(1.75rem, 3vw, 2.25rem) clamp(1.25rem, 2.5vw, 1.75rem);
    transition:
      box-shadow 0.25s var(--card-ease),
      border-color 0.25s;
    border-bottom: 3px solid transparent;
  }
  .feature:hover {
    box-shadow: var(--shadow-card-hover);
    border-bottom-color: var(--brand);
  }
  .feature__icon {
    color: var(--brand);
    background: radial-gradient(circle at 30% 30%, #e8f3fa, #d6e9f6);
    border-radius: 50%;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    margin-bottom: 0.4rem;
    display: grid;
    position: relative;
  }
  .feature__icon:after {
    content: '';
    background: var(--accent);
    border-radius: 50%;
    width: 0.6rem;
    height: 0.6rem;
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
  }
  .feature h3 {
    font-size: var(--step-1);
  }
  .feature p {
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  /* What we bring */
  .skill-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
    max-width: 58rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .skill {
    text-align: center;
    justify-content: center;
    align-items: center;
    gap: 0.7rem;
    min-height: 9.5rem;
    padding: 1.25rem 0.75rem;
    transition:
      box-shadow 0.25s var(--card-ease),
      border-color 0.25s;
    border-bottom: 3px solid transparent;
  }
  .skill:hover {
    box-shadow: var(--shadow-card-hover);
    border-bottom-color: var(--accent-deep);
  }
  .skill__icon {
    color: var(--brand);
  }
  .skill__label {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }
  @media (width>=48rem) {
    .skill-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .storyB { display: grid; gap: 2rem 3.5rem; align-items: center; padding: clamp(1.5rem, 4vw, 3rem); }
  @media (width >= 52rem) { .storyB { grid-template-columns: 1.2fr 1fr; } }
  .storyB__text h2 { margin: 0 0 1rem; }
  .storyB__text p { color: var(--ink-soft); line-height: 1.65; max-width: 36rem; margin: 0 0 1rem; }
  .storyB__panel { padding: 1.5rem; border-radius: 20px; background: var(--brand-surface); color: #fff; }
  .storyB__title { margin: 0 0 1rem; font-size: var(--step--1); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #cfe6f3; }
  .storyB__panel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .storyB__panel li { display: grid; grid-template-columns: 1fr auto 1fr; gap: .6rem; align-items: center; padding: .75rem .9rem; border-radius: 14px; background: #ffffff1a; }
  .storyB__from { color: #cfe1ec; text-decoration: line-through; text-decoration-color: #ffffff66; font-size: var(--step--1); }
  .storyB__arrow { color: var(--accent); display: grid; }
  .storyB__to { font-weight: 600; }
</style>
