---
// Booking page: a four-step request for a free 30-minute call about a service.
// Saved to the database by functions/_middleware.ts (form name "booking") and shown in CRM → Bookings. Works without JavaScript as one long form;
// with JavaScript it becomes a step-by-step form with a live summary.
// Days, times, budgets and call methods are set in src/data/site.ts (booking).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ServiceOrbit from '../components/ServiceOrbit.astro';
import { services } from '../data/services';
import { booking, site } from '../data/site';

const steps = ['Service', 'Project', 'Call time', 'Your details'];
import { getSections } from '../lib/crm';
const sections = await getSections();
const timelines = booking.timelines.filter((t) => sections.urgent_booking || !t.startsWith('Urgent'));

// One-tap WhatsApp starters for visitors who would rather chat than fill in a form.
const waStarters = [
  { label: 'Business system or BuildSmart', text: 'Hi JayTech9, I’d like to chat about a business system (stock, sales and VAT, or replacing paper and WhatsApp records).' },
  { label: 'Website or online payments', text: 'Hi JayTech9, I’m looking for a fast website for my business or organisation (with Paystack or easy updates).' },
  { label: 'Dashboard or reports', text: 'Hi JayTech9, I need help turning spreadsheets or branch and field reports into a clear dashboard.' },
  { label: 'AgriTech or field data', text: 'Hi JayTech9, I’d like to discuss field data collection, farmer records or sustainability reporting.' },
  { label: 'Design, domain or hosting', text: 'Hi JayTech9, I need help with branding and print design, or with my domain, email and hosting.' },
];
---

<Base
  title="Book a free call | JayTech9"
  description="Book a free 30-minute call about your website, business system or data. We map out a practical next step and send a written quote, with no pressure."
>
  <header class="page-head">
    <div class="wrap page-head__grid">
      <div class="page-head__text">
        <p class="eyebrow">Free 30-minute discovery call</p>
        <h1>Book a free call about your <em class="hl">website, system or data</em></h1>
        <p class="lede">
          Tell us what your team uses today (paper books, spreadsheets, WhatsApp reports or an outdated site) and
          we’ll map out a practical next step. No pressure, no jargon.
        </p>
      </div>
      <div class="page-head__aside">
        <ServiceOrbit />
      </div>
    </div>
  </header>

  <section class="section book-section" aria-label="Booking form">
    <div class="wrap">
      <div class="sheet overlap book">
        <form
          class="bform"
          id="booking-form"
          name="booking"
          method="POST"
          action="/book/thanks/"
          novalidate
        >
          <input type="hidden" name="form-name" value="booking" />
          <p class="visually-hidden" aria-hidden="true">
            <label>
              Leave this empty: <input name="company-website" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <ol class="bsteps" aria-label="Booking steps">
            {
              steps.map((s, i) => (
                <li class="bsteps__item" data-step={i}>
                  <span class="bsteps__num" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span class="bsteps__label">{s}</span>
                </li>
              ))
            }
          </ol>
          <div class="bprogress" aria-hidden="true"><span></span></div>

          <!-- Step 1: service -->
          <fieldset class="bstep" data-step="0">
            <legend class="bstep__title" tabindex="-1">Which service do you need?</legend>
            <div class="bservices">
              {
                services.map((s) => (
                  <label class="bservice">
                    <input type="radio" name="service" value={s.title} data-id={s.id} required />
                    <span class="bservice__card">
                      <span class="bservice__icon">
                        <Icon name={s.icon as any} size={22} />
                      </span>
                      <span class="bservice__text">
                        <strong>{s.title}</strong>
                        <span>{s.blurb}</span>
                      </span>
                      <span class="bservice__tick" aria-hidden="true">
                        <Icon name="check" size={14} strokeWidth={3} />
                      </span>
                    </span>
                  </label>
                ))
              }
              <label class="bservice">
                <input type="radio" name="service" value="Not sure yet" data-id="unsure" required />
                <span class="bservice__card">
                  <span class="bservice__icon">
                    <Icon name="search" size={22} />
                  </span>
                  <span class="bservice__text">
                    <strong>Not sure yet</strong>
                    <span>Tell us the problem and we’ll suggest the right fit.</span>
                  </span>
                  <span class="bservice__tick" aria-hidden="true">
                    <Icon name="check" size={14} strokeWidth={3} />
                  </span>
                </span>
              </label>
            </div>
            <p class="berror" data-for="service" hidden>Please choose a service.</p>
          </fieldset>

          <!-- Step 2: project -->
          <fieldset class="bstep" data-step="1">
            <legend class="bstep__title" tabindex="-1">Tell us about your project</legend>
            <div class="bfield">
              <label for="b-details">What would you like us to help with?</label>
              <textarea
                id="b-details"
                name="details"
                rows="5"
                required
                minlength="10"
                placeholder="For example: we sell building materials and want to track stock and sales across two shops."
              ></textarea>
              <p class="berror" data-for="details" hidden>Please add a short description (a sentence is enough).</p>
            </div>
            <div class="bfield">
              <p class="bfield__label" id="b-budget-label">Budget</p>
              <div class="bchips" role="radiogroup" aria-labelledby="b-budget-label">
                {
                  booking.budgets.map((b) => (
                    <label class="bchip">
                      <input type="radio" name="budget" value={b} />
                      <span>{b}</span>
                    </label>
                  ))
                }
              </div>
              <p class="bhint">Outside Ghana? Mention your currency in the description and we’ll quote in it.</p>
            </div>
            <div class="bfield">
              <p class="bfield__label" id="b-time-label">When do you need it?</p>
              <div class="bchips" role="radiogroup" aria-labelledby="b-time-label">
                {
                  timelines.map((b) => (
                    <label class="bchip">
                      <input type="radio" name="timeline" value={b} />
                      <span>{b}</span>
                    </label>
                  ))
                }
              </div>
            </div>
            <div class="bfield">
              <label for="b-link">
                Current website or social page <span class="optional">(optional)</span>
              </label>
              <input id="b-link" name="link" type="url" inputmode="url" placeholder="https://" />
            </div>
          </fieldset>

          <!-- Step 3: call time -->
          <fieldset class="bstep" data-step="2">
            <legend class="bstep__title" tabindex="-1">Pick a time for your free call</legend>
            <div class="bfield">
              <p class="bfield__label" id="b-method-label">How should we talk?</p>
              <div class="bchips" role="radiogroup" aria-labelledby="b-method-label">
                {
                  booking.methods.map((m, i) => (
                    <label class="bchip">
                      <input type="radio" name="method" value={m} checked={i === 1} />
                      <span>{m}</span>
                    </label>
                  ))
                }
              </div>
            </div>
            <div class="bfield">
              <label class="bfield__label" for="b-date" id="b-date-label">Day</label>
              <!-- Without JavaScript this is a normal date field. With it, it becomes the day buttons below. -->
              <input id="b-date" class="bdate-native" name="preferred_date" type="date" required />
              <div class="bdays" role="radiogroup" aria-labelledby="b-date-label" hidden></div>
              <p class="berror" data-for="preferred_date" hidden>Please choose a day.</p>
            </div>
            <div class="bfield">
              <p class="bfield__label" id="b-slot-label">Time <span class="optional">(Ghana time, GMT)</span></p>
              <div class="bchips bslots" role="radiogroup" aria-labelledby="b-slot-label">
                {
                  booking.slots.map((s) => (
                    <label class="bchip">
                      <input type="radio" name="preferred_time" value={s} required />
                      <span>
                        {s}
                        <small class="bslot__local" />
                      </span>
                    </label>
                  ))
                }
              </div>
              <p class="berror" data-for="preferred_time" hidden>Please choose a time.</p>
            </div>
          </fieldset>

          <!-- Step 4: details -->
          <fieldset class="bstep" data-step="3">
            <legend class="bstep__title" tabindex="-1">Your details</legend>
            <div class="bgrid">
              <div class="bfield">
                <label for="b-name">Full name</label>
                <input id="b-name" name="name" type="text" autocomplete="name" required />
                <p class="berror" data-for="name" hidden>Please enter your name.</p>
              </div>
              <div class="bfield">
                <label for="b-org">
                  Business or organisation <span class="optional">(optional)</span>
                </label>
                <input id="b-org" name="organisation" type="text" autocomplete="organization" />
              </div>
              <div class="bfield">
                <label for="b-email">Email</label>
                <input id="b-email" name="email" type="email" autocomplete="email" required />
                <p class="berror" data-for="email" hidden>Please enter a valid email address.</p>
              </div>
              <div class="bfield">
                <label for="b-phone">Phone or WhatsApp</label>
                <input id="b-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+233" required />
                <p class="berror" data-for="phone" hidden>Please enter a number we can reach you on.</p>
              </div>
            </div>
            <div class="bfield">
              <label for="b-source">
                How did you hear about us? <span class="optional">(optional)</span>
              </label>
              <select id="b-source" name="source">
                <option value="">Choose one</option>
                <option>Google search</option>
                <option>Social media</option>
                <option>Friend or colleague</option>
                <option>Saw our work</option>
                <option>Other</option>
              </select>
            </div>
            <input type="hidden" name="visitor_timezone" value="" />
            <p class="bhint">We only use your details to arrange this call. No spam, no sharing. <a href="/privacy/">Privacy policy</a> · <a href="/terms/">Terms and refunds</a></p>
          </fieldset>

          <div class="bnav">
            <button type="button" class="button button--quiet bnav__back" hidden>Back</button>
            <button type="button" class="button bnav__next" hidden>Continue</button>
            <button type="submit" class="button bnav__submit">Request my free call</button>
          </div>
        </form>

        <aside class="bsummary" aria-labelledby="bsum-heading">
          <div class="bcall">
            <h2 class="bcall__title">What happens on the call</h2>
            <ol class="bcall__steps">
              <li><strong>You show us how you work today.</strong> Stock and VAT, daily field updates, Paystack payments, a slow website: whatever is slowing you down.</li>
              <li><strong>We suggest practical options.</strong> An existing product, or something built around how your staff already work.</li>
              <li><strong>You get next steps and a written quote.</strong> A plain-English summary, timeline options and a price, so you can decide at your own pace.</li>
            </ol>
          </div>
          <h2 id="bsum-heading">Your booking</h2>
          <dl class="bsummary__list">
            <div><dt>Service</dt><dd data-sum="service">Not chosen yet</dd></div>
            <div><dt>Budget</dt><dd data-sum="budget">–</dd></div>
            <div><dt>Call</dt><dd data-sum="method">WhatsApp call</dd></div>
            <div><dt>When</dt><dd data-sum="when">Not chosen yet</dd></div>
          </dl>
          <ul class="bsummary__trust">
            <li><Icon name="check" size={16} strokeWidth={2.5} /> Free, no obligation</li>
            {sections.urgent_booking && <li><Icon name="check" size={16} strokeWidth={2.5} /> Urgent jobs fast-tracked</li>}
            <li><Icon name="check" size={16} strokeWidth={2.5} /> Written quote after the call</li>
            <li><Icon name="check" size={16} strokeWidth={2.5} /> You own your code, data and logins</li>
          </ul>
          <p class="bsummary__alt">
            Prefer to chat now? Tap a topic to start a WhatsApp message:
          </p>
          <ul class="bwa">
            {waStarters.map((w) => (
              <li><a href={`${site.whatsapp}?text=${encodeURIComponent(w.text)}`} rel="noopener">{w.label}</a></li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  import { booking } from '../data/site';

  const form = document.querySelector<HTMLFormElement>('.bform');
  if (form) {
    const stepsEls = Array.from(form.querySelectorAll<HTMLFieldSetElement>('.bstep'));
    const markers = Array.from(form.querySelectorAll<HTMLElement>('.bsteps__item'));
    const bar = form.querySelector<HTMLElement>('.bprogress span')!;
    const back = form.querySelector<HTMLButtonElement>('.bnav__back')!;
    const next = form.querySelector<HTMLButtonElement>('.bnav__next')!;
    const submit = form.querySelector<HTMLButtonElement>('.bnav__submit')!;
    const dateInput = form.querySelector<HTMLInputElement>('#b-date')!;
    const days = form.querySelector<HTMLElement>('.bdays')!;
    const sum = (k: string) => document.querySelector<HTMLElement>(`[data-sum="${k}"]`)!;
    let step = 0;

    form.classList.add('is-enhanced');

    // ----- Day buttons: the next working days, built in the visitor's browser so they're never stale.
    const fmtDay = new Intl.DateTimeFormat('en-GB', { weekday: 'short', timeZone: 'Africa/Accra' });
    const fmtDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'Africa/Accra' });
    const fmtLong = new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Africa/Accra' });
    const iso = (d: Date) => d.toISOString().slice(0, 10);
    const today = new Date();
    const options: Date[] = [];
    for (let i = 1; options.length < 10 && i <= booking.daysAhead + 10; i++) {
      const d = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate() + i, 12));
      if (booking.workingDays.includes(d.getUTCDay())) options.push(d);
    }
    days.innerHTML = options
      .map(
        (d) => `<label class="bday"><input type="radio" name="day-choice" value="${iso(d)}" />
        <span><small>${fmtDay.format(d)}</small><strong>${fmtDate.format(d)}</strong></span></label>`,
      )
      .join('');
    days.hidden = false;
    dateInput.classList.add('visually-hidden');
    dateInput.tabIndex = -1;
    dateInput.setAttribute('aria-hidden', 'true');
    // ----- Live availability: times someone already booked (or that we blocked) can't be picked.
    const slotInputs = Array.from(form.querySelectorAll<HTMLInputElement>('[name="preferred_time"]'));
    let avail: { taken: Record<string, string[]>; closed: string[] } = { taken: {}, closed: [] };
    const markSlots = () => {
      const taken = new Set(avail.taken[dateInput.value] ?? []);
      for (const r of slotInputs) {
        const off = taken.has(r.value);
        r.disabled = off;
        r.closest('.bchip')?.classList.toggle('is-taken', off);
        r.closest('.bchip')?.setAttribute('title', off ? 'Already booked' : '');
        if (off && r.checked) r.checked = false;
      }
    };
    const markDays = () => {
      days.querySelectorAll<HTMLInputElement>('input[name="day-choice"]').forEach((r) => {
        const full = avail.closed.includes(r.value) || (avail.taken[r.value]?.length ?? 0) >= slotInputs.length;
        r.disabled = full;
        const label = r.closest('.bday')!;
        label.classList.toggle('is-full', full);
        const small = label.querySelector('small')!;
        small.dataset.day ??= small.textContent ?? '';
        small.textContent = full ? 'Fully booked' : small.dataset.day;
        if (full && r.checked) { r.checked = false; dateInput.value = ''; }
      });
    };
    const loadAvailability = () =>
      fetch(`/api/availability?from=${iso(options[0])}&to=${iso(options[options.length - 1])}`, { cache: 'no-store' })
        .then((r) => (r.ok ? r.json() : null))
        .then((a) => { if (a?.taken) { avail = a; markDays(); markSlots(); } })
        .catch(() => { /* booking still works; the server double-checks */ });
    loadAvailability();
    days.addEventListener('change', (e) => {
      dateInput.value = (e.target as HTMLInputElement).value;
      markSlots();
      update();
    });

    // ----- Show each slot in the visitor's own time when they're not in Ghana.
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    (form.querySelector('[name="visitor_timezone"]') as HTMLInputElement).value = tz;
    if (new Date().getTimezoneOffset() !== 0) {
      form.querySelectorAll<HTMLInputElement>('[name="preferred_time"]').forEach((r) => {
        const [h, m] = r.value.split(':').map(Number);
        const d = new Date(Date.UTC(2026, 0, 15, h, m));
        const local = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const small = r.parentElement!.querySelector('.bslot__local');
        if (small) small.textContent = `${local} your time`;
      });
    }

    // ----- Preselect a service from ?service=design
    const pre = new URLSearchParams(location.search).get('service');
    const preInput = pre && form.querySelector<HTMLInputElement>(`[name="service"][data-id="${pre}"]`);
    if (preInput) preInput.checked = true;
    // ?product=buildsmart (from a product page) starts the description for them.
    const preProduct = new URLSearchParams(location.search).get('product');
    const detailsBox = form.querySelector<HTMLTextAreaElement>('[name="details"]');
    const productNames: Record<string, string> = { buildsmart: 'BuildSmart', 'field-reporting-dashboard': 'the field reporting dashboard', 'donation-management': 'the donation management system', 'carbon-credits': 'the carbon credits project' };
    if (preProduct && productNames[preProduct] && detailsBox && !detailsBox.value) {
      detailsBox.value = `I’d like a walkthrough of ${productNames[preProduct]}. `;
    }

    // ----- Validation per step
    function fieldsIn(i: number) {
      return Array.from(stepsEls[i].querySelectorAll<HTMLInputElement>('input, textarea, select')).filter(
        (el) => el.type !== 'hidden' && el.name,
      );
    }
    function showError(name: string, show: boolean) {
      const err = form!.querySelector<HTMLElement>(`.berror[data-for="${name}"]`);
      if (err) err.hidden = !show;
      form!.querySelectorAll<HTMLElement>(`[name="${name}"]`).forEach((el) => {
        if (show) el.setAttribute('aria-invalid', 'true');
        else el.removeAttribute('aria-invalid');
      });
    }
    function validate(i: number) {
      let firstBad: HTMLElement | null = null;
      const seen = new Set<string>();
      for (const el of fieldsIn(i)) {
        if (seen.has(el.name)) continue;
        seen.add(el.name);
        let ok = true;
        if (el.type === 'radio') {
          const group = form!.querySelectorAll<HTMLInputElement>(`[name="${el.name}"]`);
          const required = Array.from(group).some((r) => r.required);
          ok = !required || Array.from(group).some((r) => r.checked);
        } else if (el.name === 'preferred_date') {
          ok = !!el.value;
        } else {
          ok = el.checkValidity();
        }
        showError(el.name, !ok);
        if (!ok && !firstBad) {
          firstBad =
            el.name === 'preferred_date'
              ? days.querySelector('input')
              : el.type === 'radio'
                ? form!.querySelector<HTMLElement>(`[name="${el.name}"]`)
                : el;
        }
      }
      if (firstBad) firstBad.focus();
      return !firstBad;
    }

    function go(i: number, focus = true) {
      step = i;
      stepsEls.forEach((s, n) => (s.hidden = n !== i));
      markers.forEach((m, n) => {
        m.classList.toggle('is-done', n < i);
        m.classList.toggle('is-current', n === i);
        if (n === i) m.setAttribute('aria-current', 'step');
        else m.removeAttribute('aria-current');
      });
      bar.style.width = `${((i + 1) / stepsEls.length) * 100}%`;
      back.hidden = i === 0;
      next.hidden = i === stepsEls.length - 1;
      submit.hidden = i !== stepsEls.length - 1;
      if (focus) {
        const title = stepsEls[i].querySelector<HTMLElement>('.bstep__title');
        title?.focus({ preventScroll: true });
        form!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    next.addEventListener('click', () => {
      if (validate(step)) go(step + 1);
    });
    back.addEventListener('click', () => go(step - 1));
    form.addEventListener('submit', (e) => {
      for (let i = 0; i < stepsEls.length; i++) {
        if (!validate(i)) {
          e.preventDefault();
          go(i, false);
          validate(i);
          return;
        }
      }
      submit.disabled = true;
      submit.textContent = 'Sending…';
    });
    // Clear an error as soon as it's fixed.
    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.getAttribute('aria-invalid') && (el.type === 'radio' || el.checkValidity())) showError(el.name, false);
    });
    form.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.type === 'radio') showError(el.name === 'day-choice' ? 'preferred_date' : el.name, false);
      update();
    });

    // ----- Live summary
    const val = (n: string) => form!.querySelector<HTMLInputElement>(`[name="${n}"]:checked`)?.value;
    function update() {
      sum('service').textContent = val('service') || 'Not chosen yet';
      sum('budget').textContent = val('budget') || '–';
      sum('method').textContent = val('method') || '–';
      const t = val('preferred_time');
      const d = dateInput.value ? fmtLong.format(new Date(`${dateInput.value}T12:00:00Z`)) : '';
      sum('when').textContent = d || t ? [d, t && `${t} GMT`].filter(Boolean).join(', ') : 'Not chosen yet';
    }

    update();
    go(0, false);
  }
</script>

<style>
  .book-section {
    padding-top: 0;
  }
  .book {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding: clamp(1.25rem, 4vw, 2.5rem);
    align-items: start;
  }
  @media (width >= 62rem) {
    .book {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }

  .bform {
    scroll-margin-top: 6rem;
  }
  /* ---------- Steps header ---------- */
  .bsteps {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.5rem;
    justify-content: space-between;
  }
  .bform.is-enhanced .bsteps {
    display: flex;
  }
  .bsteps__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .bsteps__num {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: #e6edf2;
    color: var(--ink-soft);
    font-size: 0.85rem;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .bsteps__item.is-current {
    color: var(--ink);
  }
  .bsteps__item.is-current .bsteps__num {
    background: var(--brand);
    color: var(--white);
  }
  .bsteps__item.is-done .bsteps__num {
    background: var(--accent);
    color: var(--ink);
  }
  @media (width < 40rem) {
    .bsteps__item:not(.is-current) .bsteps__label {
      display: none;
    }
  }
  .bprogress {
    display: none;
    height: 6px;
    margin: 0.9rem 0 1.75rem;
    border-radius: 999px;
    background: #e6edf2;
    overflow: hidden;
  }
  .bform.is-enhanced .bprogress {
    display: block;
  }
  .bprogress span {
    display: block;
    height: 100%;
    width: 25%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--brand), var(--accent));
    transition: width 0.4s var(--card-ease, ease);
  }

  /* ---------- Steps ---------- */
  .bstep {
    margin: 0 0 2rem;
