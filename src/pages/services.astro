---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// Service cards that scroll across the page header. Each links to its section below.
const services = [
  { id: 'websites', title: 'Websites and web apps', text: 'Fast, mobile-friendly sites your team can update.', icon: 'monitor' },
  { id: 'systems', title: 'Business systems', text: 'Replace paper books, spreadsheets and WhatsApp threads.', icon: 'layers' },
  { id: 'data', title: 'Data dashboards and analysis', text: 'See your numbers clearly, without the wait.', icon: 'chart' },
  { id: 'agritech', title: 'AgriTech and sustainability', text: 'Digital tools for farmers and cooperatives.', icon: 'sprout' },
  { id: 'design', title: 'Brand and print design', text: 'Logos, flyers, banners and social graphics.', icon: 'brush' },
  { id: 'care', title: 'Domains, hosting and care', text: 'Domain, email and hosting set up and kept running.', icon: 'shield' },
] as const;
---

<Base
  title="Services | JayTech9"
  description="Websites, business systems, data dashboards, AgriTech tools, design, and domain and hosting care for businesses and organisations worldwide."
>
  <header class="page-head">
    <div class="wrap">
      <h1>Services</h1>
    </div>
    <nav class="jump" aria-label="Jump to a service">
      <div class="jump__viewport">
        <div class="jump__track">
          {[0, 1].map((copy) => (
            <ul class="jump__list" aria-hidden={copy === 1 ? 'true' : undefined}>
              {services.map((sv) => (
                <li>
                  <a class="jump__card" href={`#${sv.id}`} tabindex={copy === 1 ? -1 : undefined}>
                    <span class="jump__icon">
                      <Icon name={sv.icon} size={22} />
                    </span>
                    <span class="jump__title">{sv.title}</span>
                    <span class="jump__text">{sv.text}</span>
                    <span class="jump__more">
                      View service
                      <Icon name="arrow" size={15} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
      <button type="button" class="jump__pause" aria-label="Pause moving cards" hidden>
        <span class="jump__pause-icon"><Icon name="pause" size={14} /></span>
        <span class="jump__play-icon"><Icon name="play" size={14} /></span>
      </button>
    </nav>
  </header>
  <div class="wrap">
    <section class="service" id="websites" aria-labelledby="websites-heading">
      <div class="service__intro">
        <span class="icon-badge service__icon">
          <svg
            class="icon"
            width="24"
            height="24"
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"

            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="20" height="14" x="2" y="3" rx="2" />
            <line x1="8" x2="16" y1="21" y2="21" />
            <line x1="12" x2="12" y1="17" y2="21" />
          </svg>
        </span>
        <h2 id="websites-heading">Websites and web apps</h2>
        <p>
          Most of your customers will find you on a phone, often on mobile data. We build websites that load
          quickly, look right on small screens and turn visitors into enquiries.
        </p>
      </div>
      <div class="card service__detail">
        <h3>What’s included</h3>
        <ul>
          <li>Business and organisation websites</li>
          <li>Online shops and booking pages</li>
          <li>A content manager so you can edit pages and post news</li>
          <li>Mobile money and card payments through Paystack</li>
        </ul>
        <p class="service__fit">
          <strong>Good for:</strong> Businesses, churches, schools and NGOs that need to be found and
          contacted online.
        </p>
      </div>
    </section>
    <section class="service" id="systems" aria-labelledby="systems-heading">
      <div class="service__intro">
        <span class="icon-badge service__icon">
          <svg
            class="icon"
            width="24"
            height="24"
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"

            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" />
            <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" />
            <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" />
          </svg>
        </span>
        <h2 id="systems-heading">Business systems</h2>
        <p>
          If your team spends hours copying figures between notebooks, spreadsheets and messages, a simple
          system can do it for them. We build tools around how you already work.
        </p>
      </div>
      <div class="card service__detail">
        <h3>What’s included</h3>
        <ul>
          <li>Inventory, sales and point-of-sale systems</li>
          <li>Customer records and follow-up (CRM)</li>
          <li>Donation, membership and attendance tracking</li>
          <li>Staff accounts with the right level of access for each role</li>
        </ul>
        <p class="service__fit">
          <strong>Good for:</strong> Shops, distributors, microfinance and susu operators, and nonprofits.
        </p>
      </div>
    </section>
    <section class="service" id="data" aria-labelledby="data-heading">
      <div class="service__intro">
        <span class="icon-badge service__icon">
          <svg
            class="icon"
            width="24"
            height="24"
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"

            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 3v16a2 2 0 0 0 2 2h16" />
            <path d="M18 17V9" />
            <path d="M13 17V5" />
            <path d="M8 17v-3" />
          </svg>
        </span>
        <h2 id="data-heading">Data dashboards and analysis</h2>
        <p>
          We turn the data you already collect into live dashboards and clear reports, so you can spot what’s
          working, what isn’t, and where money is leaking.
        </p>
      </div>
      <div class="card service__detail">
        <h3>What’s included</h3>
        <ul>
          <li>Live dashboards for sales, collections or field reports</li>
          <li>Cleaning and analysing existing spreadsheets</li>
          <li>Monthly reports your board or funders can read</li>
          <li>Survey and field data analysis</li>
        </ul>
        <p class="service__fit">
          <strong>Good for:</strong> Managers who make decisions from reports and want them sooner and more
          accurate.
        </p>
      </div>
    </section>
    <section class="service" id="agritech" aria-labelledby="agritech-heading">
      <div class="service__intro">
        <span class="icon-badge service__icon">
          <svg
            class="icon"
            width="24"
            height="24"
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"

            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3" />
            <path d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4" />
            <path d="M5 21h14" />
          </svg>
        </span>
        <h2 id="agritech-heading">AgriTech and sustainability</h2>
        <p>
          Our founder trained farmers in sustainable and regenerative agriculture before moving into tech. We
          build tools that work in the field, not just in the office.
        </p>
      </div>
      <div class="card service__detail">
        <h3>What’s included</h3>
        <ul>
          <li>Mobile data collection that works in rural areas</li>
          <li>Farm records, crop cycles and quality checks</li>
          <li>Carbon credit eligibility for smallholder farmers</li>
          <li>Reports for programme partners and funders</li>
        </ul>
        <p class="service__fit">
          <strong>Good for:</strong> Farmer groups, cooperatives, agribusinesses and agricultural NGOs.
        </p>
      </div>
    </section>
    <section class="service" id="design" aria-labelledby="design-heading">
      <div class="service__intro">
        <span class="icon-badge service__icon">
          <svg
            class="icon"
            width="24"
            height="24"
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"

            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18" />
            <path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z" />
            <path d="m3 3 6.586 6.586" />
            <circle cx="11" cy="11" r="2" />
          </svg>
        </span>
        <h2 id="design-heading">Brand and print design</h2>
        <p>
          A consistent look makes a small business seem established. We design the pieces you need for print
          and online, ready to use.
        </p>
      </div>
      <div class="card service__detail">
        <h3>What’s included</h3>
        <ul>
          <li>Logos and simple brand guides</li>
          <li>Flyers, banners, programmes and brochures</li>
          <li>Social media post templates</li>
          <li>Letterheads and business cards</li>
        </ul>
        <p class="service__fit">
          <strong>Good for:</strong> New businesses, events and organisations refreshing their image.
        </p>
      </div>
    </section>
    <section class="service" id="care" aria-labelledby="care-heading">
      <div class="service__intro">
        <span class="icon-badge service__icon">
          <svg
            class="icon"
            width="24"
            height="24"
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"

            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
        </span>
        <h2 id="care-heading">Domains, hosting and care</h2>
        <p>
          We register domains in your name, set up professional email, host your site and keep it updated and
          backed up, so you can focus on your business.
        </p>
      </div>
      <div class="card service__detail">
        <h3>What’s included</h3>
        <ul>
          <li>Domain registration in your own name</li>
          <li>Email on your own domain (for example, info@yourbusiness.com)</li>
          <li>Hosting, security updates and backups</li>
          <li>Small changes and support when you need them</li>
        </ul>
        <p class="service__fit">
          <strong>Good for:</strong> Anyone who wants their online presence handled without the hassle.
        </p>
      </div>
    </section>
  </div>
  <section class="section pricing" aria-labelledby="pricing-heading">
    <div class="wrap pricing__inner">
      <h2 id="pricing-heading">How pricing works</h2>
      <div class="prose">
        <p>
          Every project is different, so we don’t guess at prices on a web page. After a free call, you get a
          written quote in your currency (cedis, dollars or other) with the scope, timeline and payment stages
          spelled out.
        </p>
        <p>
          Larger projects are usually paid in stages: a deposit to start, a payment at the halfway review, and
          the balance at launch. Hosting and care are billed yearly.
        </p>
      </div>
    </div>
  </section>
  <section class="contact-band" aria-labelledby="contact-band-heading">
    <div class="wrap contact-band__inner">
      <div class="contact-band__text">
        <h2 id="contact-band-heading">Not sure which service you need?</h2>
        <p>
          Describe the problem in your own words. We’ll tell you honestly what would help, even if it’s
          something simple you can do yourself.
        </p>
        <div class="button-row">
          <a class="button contact-band__primary" href="/contact/">
            Book a free call
          </a>
          <a class="button button--quiet contact-band__quiet" href="https://wa.me/233203651974">
            Chat on WhatsApp
          </a>
        </div>
      </div>
      <svg class="contours contact-band__art" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
        <circle cx="40" cy="560" r="18" class="contours__dot"></circle>
        <path
          d="M 110 560 A 70 70 0 0 0 40 490"
          pathLength="1"
          class="contours__arc contours__arc--green"
          style="--delay:0ms"
        ></path>
        <path
          d="M 158 560 A 118 118 0 0 0 40 442"
          pathLength="1"
          class="contours__arc contours__arc--blue"
          style="--delay:70ms"
        ></path>
        <path
          d="M 206 560 A 166 166 0 0 0 40 394"
          pathLength="1"
          class="contours__arc contours__arc--blue"
          style="--delay:140ms"
        ></path>
        <path
          d="M 254 560 A 214 214 0 0 0 40 346"
          pathLength="1"
          class="contours__arc contours__arc--green"
          style="--delay:210ms"
        ></path>
        <path
          d="M 302 560 A 262 262 0 0 0 40 298"
          pathLength="1"
          class="contours__arc contours__arc--blue"
          style="--delay:280ms"
        ></path>
        <path
          d="M 350 560 A 310 310 0 0 0 40 250"
          pathLength="1"
          class="contours__arc contours__arc--blue"
          style="--delay:350ms"
        ></path>
        <path
          d="M 398 560 A 358 358 0 0 0 40 202"
          pathLength="1"
          class="contours__arc contours__arc--green"
          style="--delay:420ms"
        ></path>
      </svg>
    </div>
  </section>
  <script is:inline>
    // Pause/play for the moving service cards (needed for anything that moves on its own).
    (function () {
      var jump = document.querySelector('.jump');
      var btn = jump && jump.querySelector('.jump__pause');
      if (!btn || !matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
      btn.hidden = false;
      btn.addEventListener('click', function () {
        var paused = jump.classList.toggle('is-paused');
        btn.setAttribute('aria-label', paused ? 'Play moving cards' : 'Pause moving cards');
      });
    })();
  </script>
</Base>

<style>
  .contours {
    width: 100%;
    overflow: visible;
  }
  .contours__arc {
    fill: none;
    stroke-width: 2.5px;
    stroke-linecap: round;
  }
  .contours__arc--blue {
    stroke: var(--blue);
  }
  .contours__arc--green {
    stroke: var(--green);
    stroke-width: 4px;
  }
  .contours__dot {
    fill: var(--green);
  }
  .contours--animate .contours__arc {
    stroke-dasharray: 1;
    stroke-dashoffset: 1px;
    animation: 0.9s cubic-bezier(0.3, 0.6, 0.2, 1) forwards draw;
    animation-delay: var(--delay);
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contours--animate .contours__arc {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
  .contact-band {
    background: var(--blue);
    color: var(--white);
    overflow: hidden;
  }
  .contact-band__inner {
    align-items: end;
    gap: 2rem;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    display: grid;
  }
  .contact-band__text {
    max-width: 34rem;
  }
  .contact-band h2 {
    max-width: 18ch;
  }
  .contact-band p {
    color: #dcecf5;
    font-size: var(--step-1);
    margin-block: 1.25rem 2rem;
    line-height: 1.5;
  }
  .contact-band__primary {
    background: var(--white);
    border-color: var(--white);
    color: var(--ink);
  }
  .contact-band__primary:hover {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }
  .contact-band__quiet {
    color: var(--white);
    border-color: var(--white);
  }
  .contact-band__quiet:hover {
    background: var(--white);
    border-color: var(--white);
    color: var(--ink);
  }
  .contact-band .contact-band__art {
    display: none;
  }
  .contact-band .contact-band__art .contours__arc--blue {
    stroke: #4d9cc8;
  }
  @media (width>=52rem) {
    .contact-band__inner {
      grid-template-columns: 1.3fr 1fr;
    }
    .contact-band .contact-band__art {
      justify-self: end;
      max-width: 22rem;
      margin-bottom: -6rem;
      display: block;
    }
  }
  /* Moving service cards in the page header. */
  .jump {
    z-index: 1;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    position: relative;
  }
  .jump__viewport {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 2.5%, #000 97.5%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 2.5%, #000 97.5%, transparent);
    padding-block: 0.5rem 1rem;
    overflow: hidden;
  }
  .jump__track {
    width: max-content;
    display: flex;
    animation: jump-scroll 45s linear infinite;
  }
  .jump:hover .jump__track,
  .jump:focus-within .jump__track,
  .jump.is-paused .jump__track {
    animation-play-state: paused;
  }
  @keyframes jump-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  .jump__list {
    gap: 1rem;
    margin: 0;
    padding: 0 0.5rem;
    list-style: none;
    display: flex;
  }
  /* .page-head makes links white, so the card restates its dark text colour. */
  .page-head .jump__card,
  .page-head .jump__card:hover {
    color: var(--ink);
  }
  .jump__card {
    background: var(--white);
    border-radius: var(--radius-lg);
    color: var(--ink);
    width: clamp(15rem, 60vw, 18rem);
    height: 100%;
    box-shadow: 0 12px 26px -14px #0006;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.25rem;
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    display: flex;
  }
  .jump__card:hover {
    color: var(--ink);
    transform: translateY(-4px);
    box-shadow: 0 0 0 3px var(--accent), 0 18px 30px -14px #0007;
  }
  .jump__card:focus-visible {
    outline-color: var(--accent);
  }
  .jump__icon {
    background: #e3f0f8;
    color: var(--brand);
    border-radius: 14px;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.25rem;
    display: grid;
  }
  .jump__title {
    font-family: var(--font-display);
    letter-spacing: -0.015em;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .jump__text {
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .jump__more {
    color: var(--brand);
    border-top: 1px solid var(--line);
    align-items: center;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    display: flex;
  }
  .jump__pause {
    cursor: pointer;
    background: #ffffff26;
    color: var(--white);
    border: 1px solid #fff6;
    border-radius: 50%;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0.25rem var(--gutter) 0 auto;
    padding: 0;
    display: grid;
  }
  .jump__pause[hidden],
  .jump__play-icon,
  .jump.is-paused .jump__pause-icon {
    display: none;
  }
  .jump.is-paused .jump__play-icon,
  .jump:not(.is-paused) .jump__pause-icon {
    display: grid;
  }
  .jump__pause :global(svg) {
    fill: currentColor;
    stroke: none;
  }
  .jump__pause:hover {
    background: var(--white);
    color: var(--brand);
  }
  @media (width>=64rem) {
    .jump__pause {
      margin-right: max(var(--gutter), calc((100vw - var(--wrap)) / 2));
    }
  }
  /* Reduced motion: no movement, the cards become a swipeable row and the copy is hidden. */
  @media (prefers-reduced-motion: reduce) {
    .jump__viewport {
      -webkit-mask-image: none;
      mask-image: none;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding-inline: var(--gutter);
      overflow-x: auto;
    }
    .jump__track {
      animation: none;
    }
    .jump__list {
      padding: 0;
    }
    .jump__list[aria-hidden] {
      display: none;
    }
    .jump__card {
      scroll-snap-align: start;
    }
  }
  .service {
    border-bottom: 1px solid var(--line);
    gap: 1.5rem 4rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
    scroll-margin-top: 5.5rem;
    display: grid;
  }
  .service h2 {
    font-size: var(--step-2);
  }
  .service__intro p {
    max-width: 48ch;
    color: var(--ink-soft);
    margin-top: 1rem;
  }
  .service__icon {
    margin-bottom: 1rem;
  }
  .service__detail h3 {
    letter-spacing: 0;
    color: var(--green-deep);
    font-size: 1rem;
  }
  .service__detail ul {
    margin: 0.25rem 0 0;
    padding-left: 1.2em;
  }
  .service__detail li + li {
    margin-top: 0.4rem;
  }
  .service__detail li::marker {
    color: var(--green-deep);
  }
  .service__fit {
    color: var(--ink-soft);
    max-width: 52ch;
    margin-top: 0.75rem;
  }
  .service__fit strong {
    color: var(--ink);
  }
  .pricing__inner {
    gap: 1.5rem 4rem;
    display: grid;
  }
  @media (width>=52rem) {
    .service,
    .pricing__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
