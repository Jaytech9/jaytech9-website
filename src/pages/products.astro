---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import { visual } from '../lib/visuals';

// All content comes from the content collections (src/content/*.json today, the CRM later).
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const heroCards = (await getCollection('banners', (b) => b.data.page === 'products' && b.data.active))
  .sort((a, b) => a.data.order - b.data.order)
  .map((b) => b.data);

// Why-us cards beside the featured product. Keep each line short.
const features = [
  { icon: 'key', title: 'You own it', text: 'Code, data and logins handed over to you.' },
  { icon: 'wallet', title: 'Local payments built in', text: 'Mobile money, cards, VAT and NHIL.' },
  { icon: 'headset', title: 'Support after launch', text: 'Fixes and changes when you need them.' },
] as const;
import CtaBand from '../components/CtaBand.astro';
import Testimonials from '../components/Testimonials.astro';
---

<Base
  title="Products | JayTech9"
  description="Products and projects by JayTech9: business software, donation and reporting systems, websites, AgriTech and open-source tools."
>
  <section class="prod-hero" aria-labelledby="prod-heading">
    <div class="wrap">
      <h1 id="prod-heading" class="visually-hidden">Products</h1>
      <div class="prod-slider" role="region" aria-roledescription="carousel" aria-label="Featured products">
        <div class="prod-slider__track">
          {heroCards.map((c, i) => (
            <article
              class="prod-hero__card"
              data-tone={c.tone}
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${heroCards.length}`}
              inert={i !== 0}
            >
              {c.image ? (
                <img class="prod-hero__art prod-hero__img" src={c.image.src} alt={c.image.alt} loading={i === 0 ? 'eager' : 'lazy'} />
              ) : (
                <div class="prod-hero__art" set:html={visual(c.visual)} />
              )}
              <div class="prod-hero__text">
                <div class="prod-hero__lines" aria-hidden="true"><span></span><span></span></div>
                {c.eyebrow && <p class="prod-hero__eyebrow">{c.eyebrow}</p>}
                <h2 class="prod-hero__title">
                  {c.before}
                  {c.highlight && <em>{c.highlight}</em>}
                  {c.after}
                </h2>
                <p class="prod-hero__sub">{c.sub}</p>
              </div>
              <a class="prod-hero__cta" href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>
                {c.cta}
                {c.external ? <span aria-hidden="true">↗</span> : <Icon name="arrow" size={16} />}
                {c.external && <span class="visually-hidden">(opens in a new tab)</span>}
              </a>
            </article>
          ))}
        </div>
      </div>
      <div class="deck-controls">
        <button type="button" class="deck-pause" aria-label="Pause slideshow" hidden>
          <svg class="deck-pause__pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1" width="3" height="10" rx="1" /><rect x="7" y="1" width="3" height="10" rx="1" /></svg>
          <svg class="deck-pause__play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z" /></svg>
        </button>
        {heroCards.map((c, i) => (
          <button type="button" class="deck-dot" aria-label={`Show card ${i + 1}: ${c.eyebrow ?? c.cta}`} aria-current={i === 0 ? 'true' : undefined} />
        ))}
      </div>
    </div>
  </section>
  <script is:inline>
    // Header slider: each card shows for 6s (its dot fills as a timer), then the row slides left to
    // the next card, looping round seamlessly. Swipe on phones; hover/focus pauses; button pauses for good.
    (function () {
      var DELAY = 6000;
      var slider = document.querySelector('.prod-slider');
      if (!slider) return;
      var track = slider.querySelector('.prod-slider__track');
      var cards = Array.prototype.slice.call(track.children);
      var n = cards.length;
      var wrap = slider.parentElement;
      var dots = Array.prototype.slice.call(wrap.querySelectorAll('.deck-dot'));
      var pause = wrap.querySelector('.deck-pause');
      var motionOK = matchMedia('(prefers-reduced-motion: no-preference)').matches;
      var index = 0, timer = null, userPaused = false, hovering = false, resumeTimer = null, busy = false;
      wrap.style.setProperty('--deck-delay', DELAY + 'ms');
      // A copy of the first card at the end lets the row keep sliding left from the last card back to the first.
      var clone = cards[0].cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('inert', '');
      track.appendChild(clone);
      function place(i, animate) {
        track.style.transition = animate && motionOK ? '' : 'none';
        track.style.transform = 'translateX(' + -i * 100 + '%)';
        if (!animate) void track.offsetWidth;
      }
      function mark(i) {
        cards.forEach(function (c, j) {
          c.classList.toggle('is-active', j === i);
          if (j === i) c.removeAttribute('inert');
          else c.setAttribute('inert', '');
        });
        dots.forEach(function (d, j) {
          if (j === i) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
        });
      }
      function go(i) {
        if (busy) return;
        if (i === n) {
          // slide onto the copy, then jump back to the real first card without animation
          busy = true;
          place(n, true);
          mark(0);
          setTimeout(function () { place(0, false); busy = false; index = 0; schedule(); }, motionOK ? 750 : 0);
          return;
        }
        index = (i + n) % n;
        place(index, true);
        mark(index);
        schedule();
      }
      function canPlay() { return motionOK && !userPaused && !hovering && !document.hidden; }
      function schedule() {
        clearTimeout(timer);
        var playing = canPlay();
        wrap.classList.toggle('is-playing', playing);
        if (playing) timer = setTimeout(function () { go(index + 1); }, DELAY);
      }
      function holdThenResume() {
        hovering = true; schedule();
        clearTimeout(resumeTimer);
        resumeTimer = setTimeout(function () { hovering = false; schedule(); }, 8000);
      }
      dots.forEach(function (d, i) { d.addEventListener('click', function () { go(i); }); });
      // swipe
      var startX = null;
      slider.addEventListener('pointerdown', function (e) { startX = e.clientX; });
      slider.addEventListener('pointerup', function (e) {
        if (startX === null) return;
        var dx = e.clientX - startX; startX = null;
        if (Math.abs(dx) > 50) { holdThenResume(); go(dx < 0 ? index + 1 : index - 1); }
      });
      mark(0);
      if (!motionOK) return;
      pause.hidden = false;
      pause.addEventListener('click', function () {
        userPaused = !userPaused;
        pause.setAttribute('aria-label', userPaused ? 'Play slideshow' : 'Pause slideshow');
        pause.classList.toggle('is-paused', userPaused);
        schedule();
      });
      slider.addEventListener('mouseenter', function () { hovering = true; schedule(); });
      slider.addEventListener('mouseleave', function () { hovering = false; schedule(); });
      slider.addEventListener('focusin', function () { hovering = true; schedule(); });
      slider.addEventListener('focusout', function () { hovering = false; schedule(); });
      document.addEventListener('visibilitychange', schedule);
      schedule();
    })();
  </script>

  <section class="section prod-why" aria-labelledby="why-heading">
    <div class="wrap">
      <div class="prod-intro">
        <h2 id="why-heading">Practical software, built and supported by one accountable team</h2>
        <div class="prod-intro__side">
          <p>Built for mobile data, local payments and the people who use it every day.</p>
          <a class="prod-pill" href="/book/">
            Book a free call
            <Icon name="arrow" size={15} />
          </a>
        </div>
      </div>
      <div class="prod-grid">
        <ul class="prod-features">
          {features.map((f) => (
            <li class="prod-feature">
              <span class="prod-feature__icon">
                <Icon name={f.icon} size={18} />
              </span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))}
          <li class="prod-feature prod-feature--art" aria-hidden="true" set:html={visual('art/systems')} />
        </ul>
        <a class="prod-spotlight" href="/products/buildsmart/">
          <span class="prod-spotlight__badge">
            <span class="status" data-status="In development">In development</span>
          </span>
          <span class="prod-spotlight__art" set:html={visual('art/websites')} />
          <span class="prod-spotlight__shadow" aria-hidden="true"></span>
          <span class="prod-spotlight__name">BuildSmart</span>
          <span class="prod-spotlight__text">Inventory, sales and accounting for hardware stores.</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section section--band work-section" aria-labelledby="all-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="all-heading">All products and projects</h2>
        <p>Delivered client projects, work in progress and our own products. Some clients aren’t named until they’ve agreed to it.</p>
      </div>
      <ul class="card-grid work-cards">
        {products.map((p) => <ProductCard product={p} />)}
      </ul>
    </div>
  </section>
  <Testimonials />
  <CtaBand
    heading="Tell us what slows your business down"
    text="Book a free 30-minute call. We’ll listen, then send a clear quote."
  />
</Base>

<style>
  /* ---------- Products hero: one large rounded card ---------- */
  .prod-hero {
    background: linear-gradient(#0068a1 0%, #005d91 45%, var(--paper) 45%);
    padding-top: clamp(0.5rem, 2vw, 1.5rem);
  }
  /* Slider: cards sit side by side and the row slides left. */
  .prod-slider {
    touch-action: pan-y;
    border-radius: clamp(22px, 3vw, 32px);
    padding-top: 0.25rem;
    overflow: hidden;
  }
  .prod-slider__track {
    transition: transform 0.75s cubic-bezier(0.65, 0, 0.35, 1);
    display: flex;
  }
  .prod-hero__card {
    flex: 0 0 100%;
    border-radius: clamp(22px, 3vw, 32px);
    color: var(--white);
    min-height: clamp(26rem, 52vw, 34rem);
    box-shadow: 0 24px 50px -28px #10293ab3;
    --fade: 13, 46, 36;
    background:
      radial-gradient(circle at 78% 30%, #2f9a4a66 0, transparent 55%),
      linear-gradient(140deg, #0d2e24 0%, #15532f 55%, #1e7a3c 100%);
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    position: relative;
    overflow: hidden;
  }
  .prod-hero__card[data-tone='ink'],
  .prod-hero__card[data-tone='blue'],
  .prod-hero__card[data-tone='blue-dark'] {
    --fade: 13, 34, 51;
    background:
      radial-gradient(circle at 78% 30%, #2aa3e055 0, transparent 55%),
      linear-gradient(140deg, #0d2233 0%, #123a56 55%, #0068a1 100%);
  }
  .prod-hero__card[data-tone='forest'],
  .prod-hero__card[data-tone='teal'] {
    --fade: 10, 46, 40;
    background:
      radial-gradient(circle at 78% 30%, #6fd04a40 0, transparent 55%),
      linear-gradient(140deg, #0a2e28 0%, #12584a 55%, #1f8a5e 100%);
  }
  /* Words of the incoming card rise in as it arrives. */
  .prod-hero__text,
  .prod-hero__cta {
    transition:
      opacity 0.6s ease 0.25s,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.25s;
  }
  .prod-hero__card:not(.is-active) .prod-hero__text {
    opacity: 0;
    transform: translateY(14px);
  }
  .prod-hero__title em {
    color: var(--accent);
    font-style: normal;
  }
  .prod-hero__img {
    object-fit: cover;
    border-radius: 14px;
    aspect-ratio: 16 / 10;
  }
  .prod-hero__art {
    opacity: 0.95;
    width: min(78%, 34rem);
    position: absolute;
    top: clamp(-1rem, -2vw, 0rem);
    right: clamp(-4rem, -3vw, -1rem);
    transform: rotate(-6deg);
    filter: drop-shadow(0 30px 40px #0008);
  }
  .prod-hero__art :global(svg) {
    width: 100%;
  }
  .prod-hero__lines {
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    display: grid;
  }
  .prod-hero__lines span {
    background: #ffffffb3;
    border-radius: 2px;
    width: 2.75rem;
    height: 2px;
    display: block;
  }
  .prod-hero__lines span + span {
    width: 1.75rem;
  }
  .prod-hero__text {
    z-index: 1;
    max-width: 34rem;
    position: relative;
  }
  .prod-hero__eyebrow {
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .prod-hero__title {
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .prod-hero__sub {
    color: #d7e8dc;
    max-width: 30rem;
    margin-top: 0.9rem;
    font-size: 0.9375rem;
  }
  .prod-hero__cta {
    z-index: 1;
    background: var(--white);
    color: var(--ink);
    border-radius: 999px;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    position: relative;
  }
  .prod-hero__cta:hover {
    background: var(--accent);
    color: var(--ink);
  }
  /* Dark fade behind the text so the headline always reads over the illustration. */
  .prod-hero__card:after {
    content: '';
    pointer-events: none;
    background: linear-gradient(to top, rgba(var(--fade), 0.95) 0%, rgba(var(--fade), 0.7) 40%, transparent 68%);
    position: absolute;
    inset: 0;
  }
  @media (width<48rem) {
    .prod-hero__card {
      min-height: 33rem;
    }
    .prod-hero__art {
      width: 64%;
      top: 0.75rem;
      right: -1.5rem;
    }
    .prod-feature {
      min-height: 8.75rem;
    }
    .prod-feature__icon {
      margin-bottom: 1.5rem;
    }
  }
  @media (width>=36rem) and (width<52rem) {
    .prod-grid .prod-features {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (width>=48rem) and (width<80rem) {
    .prod-hero__art {
      width: 44%;
      top: 1.5rem;
      right: -1.5rem;
    }
    .prod-hero__text {
      max-width: 26rem;
    }
  }
  @media (width>=48rem) {
    .prod-hero__card:after {
      background: linear-gradient(to right, rgba(var(--fade), 0.85) 0%, rgba(var(--fade), 0.5) 40%, transparent 62%);
    }
    .prod-hero__cta {
      position: absolute;
      bottom: clamp(1.5rem, 4vw, 3rem);
      right: clamp(1.5rem, 4vw, 3rem);
    }
  }
  .deck-controls {
    justify-content: center;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.85rem;
    display: flex;
  }
  .deck-pause {
    cursor: pointer;
    background: var(--white);
    color: var(--ink);
    fill: currentColor;
    box-shadow: var(--shadow-card);
    border: 0;
    border-radius: 50%;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-right: 0.35rem;
    padding: 0;
    display: grid;
  }
  .deck-pause[hidden] {
    display: none;
  }
  .deck-pause__play,
  .deck-pause.is-paused .deck-pause__pause {
    display: none;
  }
  .deck-pause.is-paused .deck-pause__play {
    display: block;
  }
  .deck-dot {
    cursor: pointer;
    background: none;
    border: 0;
    place-items: center start;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.2rem;
    display: grid;
  }
  .deck-dot:before,
  .deck-dot:after {
    content: '';
    border-radius: 999px;
    grid-area: 1 / 1;
    height: 0.5rem;
  }
  .deck-dot:before {
    background: var(--brand);
    opacity: 0.4;
    width: 0.5rem;
    transition:
      width 0.35s ease,
      opacity 0.35s ease;
  }
  .deck-dot:after {
    background: var(--ink);
    width: 0;
  }
  .deck-dot[aria-current='true']:before {
    opacity: 0.25;
    width: 1.75rem;
  }
  .deck-dot[aria-current='true']:after {
    width: 1.75rem;
  }
  .is-playing .deck-dot[aria-current='true']:after {
    animation: deck-progress var(--deck-delay, 6s) linear forwards;
  }
  @keyframes deck-progress {
    from {
      width: 0.5rem;
    }
    to {
      width: 1.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .prod-slider__track,
    .prod-hero__text,
    .prod-hero__cta {
      transition: none;
    }
    .prod-hero__card:not(.is-active) .prod-hero__text {
      opacity: 1;
      transform: none;
    }
  }
  /* ---------- Intro row + feature grid ---------- */
  .prod-intro {
    gap: 1.25rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    display: grid;
  }
  .prod-intro h2 {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    max-width: 22ch;
    line-height: 1.15;
  }
  .prod-intro__side {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    display: flex;
  }
  .prod-intro__side p {
    color: var(--ink-soft);
    max-width: 30ch;
    font-size: 0.9375rem;
  }
  .prod-pill {
    background: var(--ink);
    color: var(--white);
    border-radius: 999px;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
  }
  .prod-pill:hover {
    background: var(--brand);
    color: var(--white);
  }
  .prod-grid {
    gap: clamp(1rem, 2vw, 1.5rem);
    display: grid;
  }
  .prod-features {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .prod-feature {
    background: var(--white);
    border: var(--card-border);
    box-shadow: var(--shadow-card);
    border-radius: var(--card-radius);
    min-height: 10.5rem;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.5rem;
    display: flex;
  }
  .prod-feature__icon {
    background: #e3f0f8;
    color: var(--brand);
    border-radius: 10px;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: auto;
    display: grid;
  }
  .prod-feature h3 {
    font-size: 1.125rem;
    font-weight: 600;
  }
  .prod-feature p {
    color: var(--ink-soft);
    font-size: 0.875rem;
  }
  .prod-feature--art {
    background: linear-gradient(160deg, #dfe8ee, #c9d8e2);
    place-items: center;
    padding: 1rem;
    display: grid;
    overflow: hidden;
  }
  .prod-feature--art :global(svg) {
    width: min(100%, 13rem);
    filter: drop-shadow(0 14px 18px #10293a33);
  }
  .prod-spotlight {
    background: var(--white);
    border-radius: var(--radius-lg);
    color: var(--ink);
    box-shadow: var(--shadow-card);
    text-align: center;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.35rem;
    padding: 2rem 1.5rem 1.75rem;
    text-decoration: none;
    display: flex;
    position: relative;
  }
  .prod-spotlight:hover {
    color: var(--ink);
  }
  .prod-spotlight__badge {
    position: absolute;
    top: 1.1rem;
    left: 1.25rem;
  }
  .prod-spotlight__art {
    width: min(100%, 17rem);
    margin-top: 1rem;
    animation: float 5s ease-in-out infinite;
    display: block;
  }
  .prod-spotlight__art :global(svg) {
    width: 100%;
  }
  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }
  .prod-spotlight__shadow {
    background: radial-gradient(closest-side, #10293a40, transparent);
    width: 60%;
    height: 1rem;
    margin: 0.25rem 0 0.75rem;
    display: block;
  }
  .prod-spotlight__name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .prod-spotlight__text {
    color: var(--ink-soft);
    max-width: 26ch;
    font-size: 0.875rem;
  }
  @media (width>=52rem) {
    .prod-intro {
      grid-template-columns: 1.6fr 1fr;
      align-items: end;
    }
    .prod-grid {
      grid-template-columns: 2fr 1fr;
    }
    .prod-features {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .prod-spotlight__art {
      animation: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-card:hover .work-card__shot {
      transform: translateX(-50%);
    }
  }
</style>
