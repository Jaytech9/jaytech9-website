<style>
  /* ---------- Products hero: one large rounded card ---------- */
  .prod-hero {
    background: linear-gradient(#0068a1 0%, #005d91 45%, var(--paper) 45%);
    padding-top: clamp(0.5rem, 2vw, 1.5rem);
  }
  /* Deck: three cards stacked; the ones behind peek out above the front card. */
  .prod-hero__deck {
    padding-top: clamp(1.1rem, 2.4vw, 1.75rem);
    display: grid;
  }
  .prod-hero__card {
    grid-area: 1 / 1;
    transform-origin: 50% 0;
    transition:
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.8s ease,
      filter 0.8s ease;
    border-radius: clamp(22px, 3vw, 32px);
    color: var(--white);
    min-height: clamp(26rem, 52vw, 34rem);
    box-shadow: 0 24px 50px -28px #10293ab3;
    --fade: 13, 46, 36;
    background:
      radial-gradient(circle at 78% 30%, #2f9a4a66 0, transparent 55%),
      linear-gradient(140deg, #0d2e24 0%, #15532f 55%, #1e7a3c 100%);
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    position: relative;
    overflow: hidden;
  }
  .prod-hero__card--ink {
    --fade: 13, 34, 51;
    background:
      radial-gradient(circle at 78% 30%, #2aa3e055 0, transparent 55%),
      linear-gradient(140deg, #0d2233 0%, #123a56 55%, #0068a1 100%);
  }
  .prod-hero__card--forest {
    --fade: 10, 46, 40;
