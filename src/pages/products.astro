---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { art } from '../data/promo-art';
import { shots } from '../data/product-shots';

// Header cards that shuffle like a deck. Keep titles short so they fit on a phone.
const heroCards = [
  {
    tone: 'green',
    eyebrow: 'Products',
    title: 'Built for businesses that rely on their software.',
    sub: 'Our own products and the systems we’ve delivered for clients, from hardware stores to nonprofits.',
    cta: 'Book a demo',
    href: '/contact/',
    external: false,
    art: art.data,
  },
  {
    tone: 'ink',
    eyebrow: 'Our product · In development',
    title: 'BuildSmart: sales, stock and VAT in one place.',
    sub: 'Inventory, sales and accounting for hardware stores, with Ghana VAT, NHIL and GETFund built in.',
    cta: 'See BuildSmart',
    href: '/products/buildsmart/',
    external: false,
    art: shots.buildsmart,
  },
  {
    tone: 'forest',
    eyebrow: 'Client project · Live',
    title: 'Green Hatch Investments, now live.',
    sub: 'Website for a sustainable investment firm: plantations, farms, real estate and eco-tourism.',
    cta: 'Visit live site',
    href: 'https://greenhatchinv.com/home/',
    external: true,
    art: shots['green-hatch-investments'],
  },
];

// Why-us cards beside the featured product. Keep each line short.
const features = [
  { icon: 'key', title: 'You own it', text: 'Code, data and logins handed over to you.' },
  { icon: 'wallet', title: 'Local payments built in', text: 'Mobile money, cards, VAT and NHIL.' },
  { icon: 'headset', title: 'Support after launch', text: 'Fixes and changes when you need them.' },
] as const;
---

<Base
  title="Products | JayTech9"
  description="Products and projects by JayTech9: business software, donation and reporting systems, websites, AgriTech and open-source tools."
>
  <section class="prod-hero" aria-labelledby="prod-heading">
    <div class="wrap">
      <h1 id="prod-heading" class="visually-hidden">Products</h1>
      <div class="prod-hero__deck" role="region" aria-roledescription="carousel" aria-label="Featured products">
        {heroCards.map((c, i) => (
          <article
            class={`prod-hero__card prod-hero__card--${c.tone}`}
            data-pos={i}
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${heroCards.length}`}
            inert={i !== 0}
          >
            <div class="prod-hero__art" set:html={c.art} />
            <div class="prod-hero__text">
              <div class="prod-hero__lines" aria-hidden="true"><span></span><span></span></div>
              <p class="prod-hero__eyebrow">{c.eyebrow}</p>
              <h2 class="prod-hero__title">{c.title}</h2>
              <p class="prod-hero__sub">{c.sub}</p>
            </div>
            <a
              class="prod-hero__cta"
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener' : undefined}
            >
              {c.cta}
              {c.external ? <span aria-hidden="true">↗</span> : <Icon name="arrow" size={16} />}
              {c.external && <span class="visually-hidden">(opens in a new tab)</span>}
            </a>
          </article>
        ))}
      </div>
      <div class="deck-controls">
        <button type="button" class="deck-pause" aria-label="Pause slideshow" hidden>
          <svg class="deck-pause__pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1" width="3" height="10" rx="1" /><rect x="7" y="1" width="3" height="10" rx="1" /></svg>
          <svg class="deck-pause__play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z" /></svg>
        </button>
        {heroCards.map((c, i) => (
          <button type="button" class="deck-dot" aria-label={`Show card ${i + 1}: ${c.eyebrow}`} aria-current={i === 0 ? 'true' : undefined} />
        ))}
      </div>
    </div>
  </section>
  <script is:inline>
    // Header deck: the front card shows for 6s (its dot fills as a timer), then moves to the back
    // while the next one comes forward. Hover or focus pauses; the button pauses for good.
    (function () {
      var DELAY = 6000;
      var deck = document.querySelector('.prod-hero__deck');
      if (!deck) return;
      var cards = Array.prototype.slice.call(deck.querySelectorAll('.prod-hero__card'));
      var wrap = deck.parentElement;
      var dots = Array.prototype.slice.call(wrap.querySelectorAll('.deck-dot'));
      var pause = wrap.querySelector('.deck-pause');
      var n = cards.length, front = 0, timer = null;
      var motionOK = matchMedia('(prefers-reduced-motion: no-preference)').matches;
      var userPaused = false, hovering = false;
      wrap.style.setProperty('--deck-delay', DELAY + 'ms');
      function show(i) {
        front = (i + n) % n;
        cards.forEach(function (c, j) {
          var pos = (j - front + n) % n;
          c.setAttribute('data-pos', pos);
          if (pos === 0) c.removeAttribute('inert');
          else c.setAttribute('inert', '');
        });
        dots.forEach(function (d, j) {
          if (j === front) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
        });
        schedule();
      }
      function canPlay() { return motionOK && !userPaused && !hovering && !document.hidden; }
      function schedule() {
        clearTimeout(timer);
        var playing = canPlay();
        wrap.classList.toggle('is-playing', playing);
        if (playing) timer = setTimeout(function () { show(front + 1); }, DELAY);
      }
      dots.forEach(function (d, i) { d.addEventListener('click', function () { show(i); }); });
      if (!motionOK) return;
      pause.hidden = false;
      pause.addEventListener('click', function () {
        userPaused = !userPaused;
        pause.setAttribute('aria-label', userPaused ? 'Play slideshow' : 'Pause slideshow');
        pause.classList.toggle('is-paused', userPaused);
        schedule();
      });
      deck.addEventListener('mouseenter', function () { hovering = true; schedule(); });
      deck.addEventListener('mouseleave', function () { hovering = false; schedule(); });
      deck.addEventListener('focusin', function () { hovering = true; schedule(); });
      deck.addEventListener('focusout', function () { hovering = false; schedule(); });
      document.addEventListener('visibilitychange', schedule);
      schedule();
    })();
  </script>

  <section class="section prod-why" aria-labelledby="why-heading">
    <div class="wrap">
      <div class="prod-intro">
        <h2 id="why-heading">Practical software, built and supported by one accountable team</h2>
