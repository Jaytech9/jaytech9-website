---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

// Banner slides at the top of the home screen. Keep each title short so it fits on a phone.
const slides = [
  {
    tag: 'Websites and apps',
    icon: 'monitor',
    tone: 'ink',
    before: 'Websites that work on ',
    highlight: 'every phone',
    after: '',
    sub: 'Fast, installable and easy for your team to update.',
    cta: 'Start a project',
    href: '/contact/',
    art: `<svg viewBox="0 0 200 170" aria-hidden="true"><rect x="14" y="34" width="122" height="84" rx="8" fill="#1f5677"/><rect x="20" y="40" width="110" height="72" rx="4" fill="#e3f0f8"/><rect x="20" y="40" width="110" height="14" rx="4" fill="#0068a1"/><rect x="28" y="62" width="54" height="7" rx="3.5" fill="#10293a"/><rect x="28" y="75" width="72" height="4" rx="2" fill="#9fb3c2"/><rect x="28" y="84" width="60" height="4" rx="2" fill="#9fb3c2"/><rect x="28" y="95" width="30" height="10" rx="5" fill="#6fd04a"/><path d="M2 120h146l-8 9H10z" fill="#2c6487"/><rect x="128" y="36" width="60" height="118" rx="13" fill="#fff"/><rect x="133" y="46" width="50" height="98" rx="5" fill="#f2f5f8"/><rect x="133" y="46" width="50" height="17" rx="5" fill="#0068a1"/><rect x="137" y="69" width="20" height="19" rx="5" fill="#fff"/><rect x="159" y="69" width="20" height="19" rx="5" fill="#fff"/><rect x="137" y="92" width="20" height="19" rx="5" fill="#fff"/><rect x="159" y="92" width="20" height="19" rx="5" fill="#fff"/><circle cx="147" cy="78.5" r="4" fill="#0068a1"/><circle cx="169" cy="78.5" r="4" fill="#6fd04a"/><circle cx="147" cy="101.5" r="4" fill="#6fd04a"/><circle cx="169" cy="101.5" r="4" fill="#0068a1"/><rect x="138" y="122" width="40" height="11" rx="5.5" fill="#6fd04a"/></svg>`,
  },
  {
    tag: 'Business systems',
    icon: 'layers',
    tone: 'blue',
    before: 'Swap paper books for ',
    highlight: 'one simple system',
    after: '',
    sub: 'Sales, stock, donations and staff records in one place.',
    cta: 'Our services',
    href: '/services/#systems',
    art: `<svg viewBox="0 0 200 170" aria-hidden="true"><rect x="12" y="26" width="150" height="128" rx="14" fill="#fff"/><rect x="26" y="40" width="64" height="8" rx="4" fill="#10293a"/><rect x="26" y="54" width="40" height="5" rx="2.5" fill="#9fb3c2"/><g><circle cx="34" cy="80" r="7" fill="#6fd04a"/><path d="m30.5 80 2.5 2.5 4.5-4.5" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><rect x="48" y="77" width="60" height="6" rx="3" fill="#d6dfe6"/><rect x="122" y="76" width="28" height="8" rx="4" fill="#e3f0f8"/></g><g><circle cx="34" cy="104" r="7" fill="#6fd04a"/><path d="m30.5 104 2.5 2.5 4.5-4.5" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><rect x="48" y="101" width="48" height="6" rx="3" fill="#d6dfe6"/><rect x="122" y="100" width="28" height="8" rx="4" fill="#e3f0f8"/></g><g><circle cx="34" cy="128" r="7" fill="#0068a1"/><rect x="48" y="125" width="54" height="6" rx="3" fill="#d6dfe6"/><rect x="122" y="124" width="28" height="8" rx="4" fill="#e3f0f8"/></g><rect x="122" y="8" width="68" height="48" rx="12" fill="#6fd04a"/><rect x="132" y="20" width="30" height="6" rx="3" fill="#10293a"/><rect x="132" y="32" width="46" height="12" rx="4" fill="#fff"/></svg>`,
  },
  {
    tag: 'Data dashboards',
    icon: 'chart',
    tone: 'green',
    before: 'Your numbers, ',
    highlight: 'live',
    after: ' on one screen',
    sub: 'Filter by branch, date or product without waiting for reports.',
    cta: 'See our work',
    href: '/work/',
    art: `<svg viewBox="0 0 200 170" aria-hidden="true"><rect x="10" y="20" width="180" height="136" rx="14" fill="#fff"/><rect x="24" y="34" width="56" height="8" rx="4" fill="#10293a"/><rect x="24" y="48" width="36" height="5" rx="2.5" fill="#9fb3c2"/><circle cx="158" cy="56" r="18" fill="none" stroke="#e3f0f8" stroke-width="9"/><circle cx="158" cy="56" r="18" fill="none" stroke="#0068a1" stroke-width="9" stroke-dasharray="78 113" transform="rotate(-90 158 56)"/><circle cx="158" cy="56" r="18" fill="none" stroke="#6fd04a" stroke-width="9" stroke-dasharray="22 113" stroke-dashoffset="-78" transform="rotate(-90 158 56)"/><rect x="28" y="110" width="14" height="32" rx="3" fill="#0068a1"/><rect x="50" y="96" width="14" height="46" rx="3" fill="#0068a1"/><rect x="72" y="118" width="14" height="24" rx="3" fill="#9fc4dc"/><rect x="94" y="84" width="14" height="58" rx="3" fill="#6fd04a"/><rect x="116" y="102" width="14" height="40" rx="3" fill="#0068a1"/><polyline points="28,92 57,78 79,88 101,64 123,74 172,96" fill="none" stroke="#1e7a0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
] as const;

// The six most-used actions, shown as app-style tiles under the banner.
const tiles = [
  { label: 'Start a Project', hint: 'Free 30-min call', href: '/contact/', icon: 'rocket' },
  { label: 'Our Services', hint: '6 ways we help', href: '/services/', icon: 'layers' },
  { label: 'Our Work', hint: 'Live client projects', href: '/work/', icon: 'briefcase' },
  { label: 'WhatsApp Us', hint: 'Quick replies', href: site.whatsapp, icon: 'chat' },
  { label: 'Careers', hint: 'Join the team', href: '/careers/', icon: 'users' },
  { label: 'Support', hint: 'Help and feedback', href: `mailto:${site.email}`, icon: 'headset' },
] as const;
---

<Base
  title="JayTech9 | Websites, business systems and data tools for businesses and organisations worldwide"
  description="Websites, business systems and data tools for businesses and organisations worldwide"
>
  <section class="app-home" aria-labelledby="home-heading">
    <div class="app-home__band">
      <div class="wrap app-home__intro">
        <p class="app-home__hello">Welcome to JayTech9</p>
        <h1 id="home-heading">Simple software for growing businesses</h1>
        <p class="app-home__lede">
          Websites, business systems and data dashboards that replace paper books, spreadsheets and WhatsApp
          threads. Based in Accra, working with clients worldwide.
        </p>
      </div>
    </div>
    <div class="wrap app-home__grid">
      <div class="promo" role="region" aria-roledescription="carousel" aria-label="Highlights">
        <div class="promo__track" tabindex="0">
          {slides.map((s, i) => (
            <article
              class={`promo__slide promo__slide--${s.tone}`}
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${slides.length}`}
            >
              <div class="promo__text">
                <h2 class="promo__title">
                  {s.before}
                  <em>{s.highlight}</em>
                  {s.after}
                </h2>
                <p class="promo__sub">{s.sub}</p>
                <a class="promo__link" href={s.href}>
                  {s.cta}
                  <Icon name="arrow" size={16} />
                </a>
              </div>
              <div class="promo__art" set:html={s.art} />
              <span class="promo__tag">
                <Icon name={s.icon} size={14} />
                {s.tag}
              </span>
            </article>
          ))}
        </div>
        <div class="promo__controls">
        <button type="button" class="promo__pause" aria-label="Pause slideshow" hidden>
          <svg class="promo__pause-icon" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1" width="3" height="10" rx="1"/><rect x="7" y="1" width="3" height="10" rx="1"/></svg>
          <svg class="promo__play-icon" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z"/></svg>
        </button>
        <div class="promo__dots">
          {slides.map((s, i) => (
            <button type="button" class="promo__dot" aria-label={`Show slide ${i + 1}: ${s.tag}`} aria-current={i === 0 ? 'true' : undefined} data-index={i} />
          ))}
        </div>
        </div>
      </div>
      <nav class="quick" aria-label="Quick actions">
        <ul class="quick__grid">
          {tiles.map((t) => (
            <li>
              <a class="tile" href={t.href}>
                <span class="tile__icon">
                  <Icon name={t.icon} size={34} strokeWidth={1.6} />
                </span>
                <span class="tile__label">{t.label}</span>
                <span class="tile__hint">{t.hint}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
  <section class="section section--band" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-heading">What we offer</h2>
        <a href="/services/">All services</a>
      </div>
      <ul class="card-grid">
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="14" x="2" y="3" rx="2" />
              <line x1="8" x2="16" y1="21" y2="21" />
              <line x1="12" x2="12" y1="17" y2="21" />
            </svg>
          </span>
          <h3>
            <a href="/services/#websites">Websites and web apps</a>
          </h3>
          <p>Fast, mobile-friendly sites your team can update without a developer.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" />
              <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" />
              <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" />
            </svg>
          </span>
          <h3>
            <a href="/services/#systems">Business systems</a>
          </h3>
          <p>Software that replaces paper books, spreadsheets and WhatsApp threads.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 3v16a2 2 0 0 0 2 2h16" />
              <path d="M18 17V9" />
              <path d="M13 17V5" />
              <path d="M8 17v-3" />
            </svg>
          </span>
          <h3>
            <a href="/services/#data">Data dashboards and analysis</a>
          </h3>
          <p>See your numbers clearly, without waiting for someone to add them up.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3" />
              <path d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4" />
              <path d="M5 21h14" />
            </svg>
          </span>
          <h3>
            <a href="/services/#agritech">AgriTech and sustainability</a>
          </h3>
          <p>Digital tools for farmers, cooperatives and agricultural programmes.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18" />
              <path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z" />
              <path d="m3 3 6.586 6.586" />
              <circle cx="11" cy="11" r="2" />
            </svg>
          </span>
          <h3>
            <a href="/services/#design">Brand and print design</a>
          </h3>
          <p>Logos, flyers, banners and social media graphics that look professional.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </span>
          <h3>
            <a href="/services/#care">Domains, hosting and care</a>
          </h3>
          <p>Your website, email and domain set up properly and kept running.</p>
          <span class="card__more">Learn more</span>
        </li>
      </ul>
    </div>
  </section>
  <section class="section" aria-labelledby="work-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-heading">Recent work</h2>
        <a href="/work/">All projects</a>
      </div>
      <ul class="card-grid work-cards">
        <li class="card card--link work-card">
          <div class="work-card__cover tone-ink">
            <span class="work-card__icon">
              <svg
                class="icon"
                width="22"
                height="22"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09" />
                <path d="M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z" />
                <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05" />
              </svg>
            </span>
            <span class="work-card__sector">Product</span>
          </div>
          <div class="work-card__body">
            <div class="work-card__meta">
              <span>Our own product</span>
              <span class="status" data-status="In development">
                In development
              </span>
            </div>
            <h3 class="work-card__title">
              <a href="/work/buildsmart/">BuildSmart</a>
            </h3>
            <p>
              Inventory, sales and accounting software for hardware stores and building material suppliers in
              Ghana, with Ghana VAT, NHIL and GETFund built in.
            </p>
            <ul class="work-card__stack" aria-label="Built with">
              <li>Node.js</li>
              <li>Express</li>
              <li>PostgreSQL</li>
              <li>Docker</li>
            </ul>
          </div>
        </li>
        <li class="card card--link work-card">
          <div class="work-card__cover tone-teal">
            <span class="work-card__icon">
              <svg
                class="icon"
                width="22"
                height="22"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" />
              </svg>
            </span>
            <span class="work-card__sector">Nonprofit</span>
          </div>
          <div class="work-card__body">
            <div class="work-card__meta">
              <span>A Ghanaian nonprofit</span>
              <span class="status" data-status="Delivered">
                Delivered
              </span>
            </div>
            <h3 class="work-card__title">
              <a href="/work/donation-management/">Donation management system</a>
            </h3>
            <p>
              Online giving through Paystack, with a private dashboard that shows who gave, how much and when.
            </p>
            <ul class="work-card__stack" aria-label="Built with">
              <li>PHP</li>
              <li>MySQL</li>
              <li>Paystack</li>
              <li>Chart.js</li>
            </ul>
          </div>
        </li>
        <li class="card card--link work-card">
          <div class="work-card__cover tone-blue">
            <span class="work-card__icon">
              <svg
                class="icon"
                width="22"
                height="22"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 3v16a2 2 0 0 0 2 2h16" />
                <path d="M18 17V9" />
                <path d="M13 17V5" />
                <path d="M8 17v-3" />
              </svg>
            </span>
            <span class="work-card__sector">Finance</span>
          </div>
          <div class="work-card__body">
            <div class="work-card__meta">
              <span>A susu and microfinance platform</span>
              <span class="status" data-status="In progress">
                In progress
              </span>
            </div>
            <h3 class="work-card__title">
              <a href="/work/field-reporting-dashboard/">Field reporting dashboard</a>
            </h3>
            <p>
              Replacing daily WhatsApp reports from branch field officers with a live dashboard that managers
              can filter by branch and date.
            </p>
            <ul class="work-card__stack" aria-label="Built with">
              <li>PHP</li>
              <li>MySQL</li>
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </section>
  <section class="section section--band" aria-labelledby="why-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="why-heading">Why businesses choose JayTech9</h2>
        <p>
          We started in agricultural field work, where most of the day went on paperwork. That’s still how we
          approach every project: understand the real problem first, then build the simplest tool that fixes
          it.
        </p>
      </div>
      <ul class="card-grid">
        <li class="card">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
              <path d="M2 12h20" />
            </svg>
          </span>
          <h3>Built for real-world conditions</h3>
          <p>
            Pages that load fast on mobile data, local payment methods like mobile money and cards, and local
            taxes built in where you need them.
          </p>
        </li>
        <li class="card">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m11 17 2 2a1 1 0 1 0 3-3" />
              <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" />
              <path d="m21 3 1 11h-2" />
              <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" />
              <path d="M3 4h8" />
            </svg>
          </span>
          <h3>Field experience, not just code</h3>
          <p>
            We’ve worked alongside farmers, field officers and shop staff, so we design for the people who
            will actually use the tool.
          </p>
        </li>
        <li class="card">
