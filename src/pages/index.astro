---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import Promo from '../components/Promo.astro';
import ProductCard from '../components/ProductCard.astro';
import { visual } from '../lib/visuals';
import { site } from '../data/site';

// Banner slides and featured products come from the content collections (src/content/*.json, later the CRM).
const slides = (await getCollection('banners', (b) => b.data.page === 'home' && b.data.active))
  .sort((a, b) => a.data.order - b.data.order)
  .map((b) => ({ ...b.data, tag: b.data.tag ?? '', art: visual(b.data.visual) }));
const featured = (await getCollection('products', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);

// The six most-used actions, shown as app-style tiles under the banner.
const tiles = [
  { label: 'Book a Call', hint: 'Free, 30 minutes', href: '/book/', icon: 'rocket' },
  { label: 'Our Services', hint: '6 ways we help', href: '/services/', icon: 'layers' },
  { label: 'Our Products', hint: 'Software we build', href: '/products/', icon: 'package' },
  { label: 'WhatsApp Us', hint: 'Quick replies', href: site.whatsapp, icon: 'chat' },
  { label: 'Gallery', hint: 'Our design work', href: '/design/', icon: 'brush' },
  { label: 'About Us', hint: 'Who we are', href: '/about/', icon: 'info' },
] as const;
import CtaBand from '../components/CtaBand.astro';
import Testimonials from '../components/Testimonials.astro';
import RecentDesigns from '../components/RecentDesigns.astro';
---

<Base
  title="JayTech9 | Websites, business systems and data tools for businesses and organisations worldwide"
  description="Websites, business systems and data tools for businesses and organisations worldwide"
>
  <section class="app-home" aria-labelledby="home-heading">
    <div class="app-home__band">
      <div class="wrap app-home__intro">
        <h1 id="home-heading">Simple software for growing businesses</h1>
      </div>
    </div>
    <div class="wrap app-home__grid">
      <Promo slides={slides} label="Highlights" />
      <nav class="quick" aria-label="Quick actions">
        <ul class="quick__grid">
          {tiles.map((t) => (
            <li>
              <a class="tile" href={t.href}>
                <span class="tile__icon">
                  <Icon name={t.icon} size={34} strokeWidth={1.6} />
                </span>
                <span class="tile__label">{t.label}</span>
                <span class="tile__hint">{t.hint}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
  <section class="section section--band" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-heading">What we offer</h2>
        <a href="/services/">All services</a>
      </div>
      <ul class="card-grid">
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="14" x="2" y="3" rx="2" />
              <line x1="8" x2="16" y1="21" y2="21" />
              <line x1="12" x2="12" y1="17" y2="21" />
            </svg>
          </span>
          <h3>
            <a href="/services/#websites">Websites and web applications</a>
          </h3>
          <p>Fast, mobile-friendly sites your team can update without a developer.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" />
              <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" />
              <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" />
            </svg>
          </span>
          <h3>
            <a href="/services/#systems">Business systems</a>
          </h3>
          <p>Software that replaces paper books, spreadsheets and WhatsApp threads.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 3v16a2 2 0 0 0 2 2h16" />
              <path d="M18 17V9" />
              <path d="M13 17V5" />
              <path d="M8 17v-3" />
            </svg>
          </span>
          <h3>
            <a href="/services/#data">Data dashboards and analysis</a>
          </h3>
          <p>See your numbers clearly, without waiting for someone to add them up.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3" />
              <path d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4" />
              <path d="M5 21h14" />
            </svg>
          </span>
          <h3>
            <a href="/services/#agritech">AgriTech and sustainability</a>
          </h3>
          <p>Digital tools for farmers, cooperatives and agricultural programmes.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18" />
              <path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z" />
              <path d="m3 3 6.586 6.586" />
              <circle cx="11" cy="11" r="2" />
            </svg>
          </span>
          <h3>
            <a href="/services/#design">Brand and print design</a>
          </h3>
          <p>Logos, flyers, banners and social media graphics that look professional.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </span>
          <h3>
            <a href="/services/#care">Domains, hosting and care</a>
          </h3>
          <p>Your website, email and domain set up properly and kept running.</p>
          <span class="card__more">Learn more</span>
        </li>
      </ul>
    </div>
  </section>
  <section class="section" aria-labelledby="work-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-heading">Our products</h2>
        <a href="/products/">All products</a>
      </div>
      <ul class="card-grid work-cards">
        {featured.map((p) => <ProductCard product={p} wide={false} />)}
      </ul>
    </div>
  </section>
  <RecentDesigns />
  <Testimonials />
  <section class="section section--band" aria-labelledby="why-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="why-heading">Why businesses choose JayTech9</h2>
        <p>
          We started in agricultural field work, where most of the day went on paperwork. That’s still how we
          approach every project: understand the real problem first, then build the simplest tool that fixes
          it.
        </p>
      </div>
      <ul class="card-grid">
        <li class="card">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
              <path d="M2 12h20" />
            </svg>
          </span>
          <h3>Built for real-world conditions</h3>
          <p>
            Pages that load fast on mobile data, local payment methods like mobile money and cards, and local
            taxes built in where you need them.
          </p>
        </li>
        <li class="card">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m11 17 2 2a1 1 0 1 0 3-3" />
              <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" />
              <path d="m21 3 1 11h-2" />
              <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" />
              <path d="M3 4h8" />
            </svg>
          </span>
          <h3>Field experience, not just code</h3>
          <p>
            We’ve worked alongside farmers, field officers and shop staff, so we design for the people who
            will actually use the tool.
          </p>
        </li>
        <li class="card">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" />
              <circle cx="16.5" cy="7.5" r=".5" fill="currentColor" />
            </svg>
          </span>
          <h3>You own what you pay for</h3>
          <p>
            Your domain is registered in your name, your data stays yours, and you receive the code and logins
            at handover.
          </p>
        </li>
      </ul>
      <p class="why__more">
        <a href="/about/">More about JayTech9</a>
      </p>
    </div>
  </section>
  <CtaBand
    heading="Every business is different."
    highlight="Let’s talk about yours."
    text=""
  />
</Base>

<style>
  /* ---------- App home: blue band, banner carousel, quick tiles ---------- */
  .app-home__band {
    background: var(--brand-surface);
    color: var(--white);
    padding-block: clamp(0.75rem, 3vw, 2.5rem) 8.5rem;
    position: relative;
    overflow: hidden;
  }
  .app-home__band:after {
    content: '';
    pointer-events: none;
    background: radial-gradient(closest-side, #ffffff21, transparent);
    border-radius: 50%;
    width: 26rem;
    height: 26rem;
    position: absolute;
    bottom: -10rem;
    right: -8rem;
  }
  .app-home__intro {
    z-index: 1;
    position: relative;
  }
  .app-home h1 {
    max-width: 20ch;
    margin-top: 0.25rem;
    font-size: clamp(1.625rem, 1rem + 2.6vw, 3.25rem);
    letter-spacing: -0.03em;
  }
  @media (width>=40rem) {
  }
  .app-home__grid {
    gap: 1.5rem;
    margin-top: -7.5rem;
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    position: relative;
  }
  /* Quick-action tiles */
  .quick__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 2.5vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .tile {
    background: var(--white);
    border-radius: var(--card-radius);
    box-shadow: var(--shadow-card);
    color: var(--ink);
    text-align: center;
    border: var(--card-border);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.35rem;
    height: 100%;
    min-height: 8.5rem;
    padding: 1rem 0.4rem;
    text-decoration: none;
    display: flex;
  }
  .tile__icon {
    color: var(--brand);
    margin-bottom: 0.35rem;
    position: relative;
  }
  .tile__icon:after {
    content: '';
    background: var(--accent);
    border-radius: 50%;
    width: 0.55rem;
    height: 0.55rem;
    position: absolute;
    top: -2px;
    right: -6px;
  }
  .tile__label {
    font-size: clamp(0.875rem, 0.8rem + 0.3vw, 1rem);
    font-weight: 600;
    line-height: 1.2;
  }
  .tile__hint {
    color: var(--ink-soft);
    font-size: 0.75rem;
    line-height: 1.25;
  }
  @media (width>=48rem) {
    .tile {
      min-height: 10rem;
    }
  }
  @media (width>=64rem) {
    .app-home__band {
      padding-bottom: 10rem;
    }
    .app-home__grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      align-items: start;
      gap: 1.75rem;
      margin-top: -8rem;
    }
    .quick__grid {
      grid-template-rows: repeat(2, 1fr);
      height: 21rem;
    }
    .tile {
      min-height: 0;
    }
  }
  .why__more {
    margin-top: 1.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .work-card:hover .work-card__shot {
      transform: translateX(-50%);
    }
  }
</style>
