---
import Base from '../layouts/Base.astro';
---

<Base
  title="JayTech9 | Websites, business systems and data tools for businesses and organisations worldwide"
  description="Websites, business systems and data tools for businesses and organisations worldwide"
>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <h1>Simple software for growing businesses</h1>
        <p class="lede">
          We build websites, business systems and data dashboards that replace paper books, spreadsheets and
          WhatsApp threads. Based in Accra, working with clients worldwide.
        </p>
        <div class="button-row">
          <a class="button hero__primary" href="/contact/">
            Book a free call
          </a>
          <a class="button hero__quiet" href="/work/">
            See our work
          </a>
        </div>
      </div>
      <div class="hero__art">
        <svg class="contours contours--animate" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
          <circle cx="40" cy="560" r="18" class="contours__dot"></circle>
          <path
            d="M 110 560 A 70 70 0 0 0 40 490"
            pathLength="1"
            class="contours__arc contours__arc--green"
            style="--delay:0ms"
          ></path>
          <path
            d="M 158 560 A 118 118 0 0 0 40 442"
            pathLength="1"
            class="contours__arc contours__arc--blue"
            style="--delay:70ms"
          ></path>
          <path
            d="M 206 560 A 166 166 0 0 0 40 394"
            pathLength="1"
            class="contours__arc contours__arc--blue"
            style="--delay:140ms"
          ></path>
          <path
