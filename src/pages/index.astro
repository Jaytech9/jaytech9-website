            pathLength="1"
            class="contours__arc contours__arc--blue"
            style="--delay:350ms"
          ></path>
          <path
            d="M 398 560 A 358 358 0 0 0 40 202"
            pathLength="1"
            class="contours__arc contours__arc--green"
            style="--delay:420ms"
          ></path>
          <path
            d="M 446 560 A 406 406 0 0 0 40 154"
            pathLength="1"
            class="contours__arc contours__arc--blue"
            style="--delay:490ms"
          ></path>
          <path
            d="M 494 560 A 454 454 0 0 0 40 106"
            pathLength="1"
            class="contours__arc contours__arc--blue"
            style="--delay:560ms"
          ></path>
          <path
            d="M 542 560 A 502 502 0 0 0 40 58"
            pathLength="1"
            class="contours__arc contours__arc--green"
            style="--delay:630ms"
          ></path>
          <path
            d="M 590 560 A 550 550 0 0 0 40 10"
            pathLength="1"
            class="contours__arc contours__arc--blue"
            style="--delay:700ms"
          ></path>
        </svg>
      </div>
    </div>
  </section>
  <section class="section section--band" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-heading">What we offer</h2>
        <a href="/services/">All services</a>
      </div>
      <ul class="card-grid">
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="14" x="2" y="3" rx="2" />
              <line x1="8" x2="16" y1="21" y2="21" />
              <line x1="12" x2="12" y1="17" y2="21" />
            </svg>
          </span>
          <h3>
            <a href="/services/#websites">Websites and web apps</a>
          </h3>
          <p>Fast, mobile-friendly sites your team can update without a developer.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" />
              <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" />
              <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" />
            </svg>
          </span>
          <h3>
            <a href="/services/#systems">Business systems</a>
          </h3>
          <p>Software that replaces paper books, spreadsheets and WhatsApp threads.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 3v16a2 2 0 0 0 2 2h16" />
              <path d="M18 17V9" />
              <path d="M13 17V5" />
              <path d="M8 17v-3" />
            </svg>
          </span>
          <h3>
            <a href="/services/#data">Data dashboards and analysis</a>
          </h3>
          <p>See your numbers clearly, without waiting for someone to add them up.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3" />
              <path d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4" />
              <path d="M5 21h14" />
            </svg>
          </span>
          <h3>
            <a href="/services/#agritech">AgriTech and sustainability</a>
          </h3>
          <p>Digital tools for farmers, cooperatives and agricultural programmes.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18" />
              <path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z" />
              <path d="m3 3 6.586 6.586" />
              <circle cx="11" cy="11" r="2" />
            </svg>
          </span>
          <h3>
            <a href="/services/#design">Brand and print design</a>
          </h3>
          <p>Logos, flyers, banners and social media graphics that look professional.</p>
          <span class="card__more">Learn more</span>
        </li>
        <li class="card card--link">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </span>
          <h3>
            <a href="/services/#care">Domains, hosting and care</a>
          </h3>
          <p>Your website, email and domain set up properly and kept running.</p>
          <span class="card__more">Learn more</span>
        </li>
      </ul>
    </div>
  </section>
  <section class="section" aria-labelledby="work-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-heading">Recent work</h2>
        <a href="/work/">All projects</a>
      </div>
      <ul class="card-grid work-cards">
        <li class="card card--link work-card">
          <div class="work-card__cover tone-ink">
            <span class="work-card__icon">
              <svg
                class="icon"
                width="22"
                height="22"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09" />
                <path d="M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z" />
                <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05" />
              </svg>
            </span>
            <span class="work-card__sector">Product</span>
          </div>
          <div class="work-card__body">
            <div class="work-card__meta">
              <span>Our own product</span>
              <span class="status" data-status="In development">
                In development
              </span>
            </div>
            <h3 class="work-card__title">
              <a href="/work/buildsmart/">BuildSmart</a>
            </h3>
            <p>
              Inventory, sales and accounting software for hardware stores and building material suppliers in
              Ghana, with Ghana VAT, NHIL and GETFund built in.
            </p>
            <ul class="work-card__stack" aria-label="Built with">
              <li>Node.js</li>
              <li>Express</li>
              <li>PostgreSQL</li>
              <li>Docker</li>
            </ul>
          </div>
        </li>
        <li class="card card--link work-card">
          <div class="work-card__cover tone-teal">
            <span class="work-card__icon">
              <svg
                class="icon"
                width="22"
                height="22"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" />
              </svg>
            </span>
            <span class="work-card__sector">Nonprofit</span>
          </div>
          <div class="work-card__body">
            <div class="work-card__meta">
              <span>A Ghanaian nonprofit</span>
              <span class="status" data-status="Delivered">
                Delivered
              </span>
            </div>
            <h3 class="work-card__title">
              <a href="/work/donation-management/">Donation management system</a>
            </h3>
            <p>
              Online giving through Paystack, with a private dashboard that shows who gave, how much and when.
            </p>
            <ul class="work-card__stack" aria-label="Built with">
              <li>PHP</li>
              <li>MySQL</li>
              <li>Paystack</li>
              <li>Chart.js</li>
            </ul>
          </div>
        </li>
        <li class="card card--link work-card">
          <div class="work-card__cover tone-blue">
            <span class="work-card__icon">
              <svg
                class="icon"
                width="22"
                height="22"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 3v16a2 2 0 0 0 2 2h16" />
                <path d="M18 17V9" />
                <path d="M13 17V5" />
                <path d="M8 17v-3" />
              </svg>
            </span>
            <span class="work-card__sector">Finance</span>
          </div>
          <div class="work-card__body">
            <div class="work-card__meta">
              <span>A susu and microfinance platform</span>
              <span class="status" data-status="In progress">
                In progress
              </span>
            </div>
            <h3 class="work-card__title">
              <a href="/work/field-reporting-dashboard/">Field reporting dashboard</a>
            </h3>
            <p>
              Replacing daily WhatsApp reports from branch field officers with a live dashboard that managers
              can filter by branch and date.
            </p>
            <ul class="work-card__stack" aria-label="Built with">
              <li>PHP</li>
              <li>MySQL</li>
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </section>
  <section class="section section--band" aria-labelledby="why-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="why-heading">Why businesses choose JayTech9</h2>
        <p>
          We started in agricultural field work, where most of the day went on paperwork. That’s still how we
          approach every project: understand the real problem first, then build the simplest tool that fixes
          it.
        </p>
      </div>
      <ul class="card-grid">
        <li class="card">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
              <path d="M2 12h20" />
            </svg>
          </span>
          <h3>Built for real-world conditions</h3>
          <p>
            Pages that load fast on mobile data, local payment methods like mobile money and cards, and local
            taxes built in where you need them.
          </p>
        </li>
        <li class="card">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m11 17 2 2a1 1 0 1 0 3-3" />
              <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" />
              <path d="m21 3 1 11h-2" />
              <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" />
              <path d="M3 4h8" />
            </svg>
          </span>
          <h3>Field experience, not just code</h3>
          <p>
            We’ve worked alongside farmers, field officers and shop staff, so we design for the people who
            will actually use the tool.
          </p>
        </li>
        <li class="card">
          <span class="icon-badge">
            <svg
              class="icon"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"

              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" />
              <circle cx="16.5" cy="7.5" r=".5" fill="currentColor" />
            </svg>
          </span>
          <h3>You own what you pay for</h3>
          <p>
            Your domain is registered in your name, your data stays yours, and you receive the code and logins
            at handover.
          </p>
        </li>
      </ul>
      <p class="why__more">
        <a href="/about/">More about JayTech9</a>
      </p>
    </div>
  </section>
  <section class="section" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="process-heading">How a project works</h2>
      </div>
      <ol class="card-grid steps">
        <li class="card step">
          <h3>Free call</h3>
          <p>
            A 30-minute conversation about your business and what’s slowing it down. No cost, no obligation.
          </p>
        </li>
        <li class="card step">
          <h3>Written quote</h3>
          <p>
            A clear scope, timeline and price in your currency, so you know exactly what you’re getting before
            you pay.
          </p>
        </li>
        <li class="card step">
          <h3>Build and review</h3>
          <p>You see progress every week and can try things early, so there are no surprises at the end.</p>
        </li>
        <li class="card step">
          <h3>Launch and support</h3>
          <p>We put it live, train your team, and stay on hand for fixes and changes afterwards.</p>
        </li>
      </ol>
    </div>
  </section>
  <section class="contact-band" aria-labelledby="contact-band-heading">
    <div class="wrap contact-band__inner">
      <div class="contact-band__text">
        <h2 id="contact-band-heading">Tell us what slows your business down</h2>
        <p>
          Start with a free 30-minute call. We’ll listen, suggest what would help, and send a written quote
          with a clear timeline.
        </p>
        <div class="button-row">
          <a class="button contact-band__primary" href="/contact/">
            Book a free call
          </a>
          <a class="button button--quiet contact-band__quiet" href="https://wa.me/233203651974">
            Chat on WhatsApp
          </a>
        </div>
      </div>
      <svg class="contours contact-band__art" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
        <circle cx="40" cy="560" r="18" class="contours__dot"></circle>
        <path
          d="M 110 560 A 70 70 0 0 0 40 490"
          pathLength="1"
          class="contours__arc contours__arc--green"
          style="--delay:0ms"
        ></path>
        <path
          d="M 158 560 A 118 118 0 0 0 40 442"
          pathLength="1"
          class="contours__arc contours__arc--blue"
          style="--delay:70ms"
        ></path>
        <path
          d="M 206 560 A 166 166 0 0 0 40 394"
          pathLength="1"
          class="contours__arc contours__arc--blue"
          style="--delay:140ms"
        ></path>
        <path
          d="M 254 560 A 214 214 0 0 0 40 346"
          pathLength="1"
          class="contours__arc contours__arc--green"
          style="--delay:210ms"
        ></path>
        <path
          d="M 302 560 A 262 262 0 0 0 40 298"
          pathLength="1"
          class="contours__arc contours__arc--blue"
          style="--delay:280ms"
        ></path>
        <path
          d="M 350 560 A 310 310 0 0 0 40 250"
          pathLength="1"
          class="contours__arc contours__arc--blue"
          style="--delay:350ms"
        ></path>
        <path
          d="M 398 560 A 358 358 0 0 0 40 202"
          pathLength="1"
          class="contours__arc contours__arc--green"
          style="--delay:420ms"
        ></path>
      </svg>
    </div>
  </section>
</Base>

<style>
  .work-card {
    gap: 0;
    padding: 0;
    overflow: hidden;
  }
  .work-card__cover {
    height: 8.5rem;
    color: var(--white);
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    display: flex;
    position: relative;
    overflow: hidden;
  }
  .work-card__cover:before {
    content: '';
    background: repeating-radial-gradient(circle at 100% 100%, #0000 0 18px, #ffffff29 18px 20px);
    position: absolute;
    inset: 0;
  }
  .tone-ink {
    background: var(--ink);
  }
  .tone-teal {
    background: var(--teal);
  }
  .tone-blue {
    background: var(--blue);
  }
  .tone-blue-dark {
    background: var(--blue-dark);
  }
  .tone-green {
    background: var(--green-deep);
  }
  .tone-ink-soft {
    background: var(--ink-soft);
  }
  .work-card__icon {
    background: #ffffff2e;
    border-radius: 50%;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    position: relative;
  }
  .work-card__sector {
    font-size: var(--step--1);
    background: #ffffff2e;
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-weight: 500;
    position: relative;
  }
  .work-card__body {
    flex-direction: column;
    flex: 1;
    gap: 0.6rem;
    padding: 1.25rem 1.25rem 1.5rem;
    display: flex;
  }
  .work-card__meta {
    font-size: var(--step--1);
    color: var(--ink-soft);
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    display: flex;
  }
  .work-card__title {
    font-size: var(--step-1);
  }
  .work-card:hover .work-card__title a {
    color: var(--blue);
  }
