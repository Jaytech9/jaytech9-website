---
import Base from '../../layouts/Base.astro';
---

<Base title="Thank you | JayTech9" description="Thanks for sharing your experience with JayTech9." noindex>
  <section class="section">
    <div class="wrap thanks">
      <h1>Thank you for your <em class="hl">review</em></h1>
      <p class="lede">We read every review before it goes on the website. We appreciate you taking the time.</p>
      <div class="button-row">
        <a class="button" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .thanks .lede {
    margin-block: 1.5rem 2.25rem;
  }
</style>
