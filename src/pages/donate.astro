---
import Base from '../layouts/Base.astro';
import { bank, site } from '../data/site';
import '../styles/orderflow.css';
// Online giving goes through Paystack (functions/api/donate.ts). Gifts show in CRM → Donations.
const amounts = [20, 50, 100, 200, 500];
---

<Base
  title="Donate | JayTech9"
  description="Support JayTech9's community work: digital tools for smallholder farmers, digital skills training, and technology for community organisations."
>
  <header class="page-head donate-hero">
    <img
      class="donate-hero__img"
      src="/images/donate-farmers.webp"
      srcset="/images/donate-farmers-900.webp 900w, /images/donate-farmers.webp 1600w"
      sizes="100vw"
      width="1600"
      height="900"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
    <div class="wrap donate-hero__content">
      <h1>Support our <em class="hl">community work</em></h1>
      <p class="lede">
        Your gift helps bring useful technology to farmers, young people and community organisations who would
        otherwise go without.
      </p>
    </div>
  </header>
  <section class="section" aria-labelledby="uses-heading">
    <div class="wrap donate overlap sheet">
      <div>
        <h2 id="uses-heading">What your gift supports</h2>
        <ul class="uses">
          <li class="card use">
            <span class="icon-badge">
              <svg
                class="icon"
                width="24"
                height="24"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3" />
                <path d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4" />
                <path d="M5 21h14" />
              </svg>
            </span>
            <h3>Digital tools for smallholder farmers</h3>
            <p>
              Record-keeping and data collection tools that help farmers track their crops and qualify for
              programmes such as carbon credits.
            </p>
          </li>
          <li class="card use">
            <span class="icon-badge">
              <svg
                class="icon"
                width="24"
                height="24"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
                <path d="M22 10v6" />
                <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
              </svg>
            </span>
            <h3>Digital skills training</h3>
            <p>
              Practical sessions for young people, farmers and small business owners on using technology in
              their work.
            </p>
          </li>
          <li class="card use">
            <span class="icon-badge">
              <svg
                class="icon"
                width="24"
                height="24"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <path d="M16 3.128a4 4 0 0 1 0 7.744" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                <circle cx="9" cy="7" r="4" />
              </svg>
            </span>
            <h3>Support for community organisations</h3>
            <p>
              Low-cost or free websites and tools for churches, schools and small nonprofits that couldn’t
              otherwise afford them.
            </p>
          </li>
        </ul>
      </div>
      <aside class="give" id="give" aria-labelledby="give-heading">
        <h2 id="give-heading">Give now</h2>
        <p class="give__raised" id="give-raised" hidden></p>
        <form id="give-form" novalidate>
          <div class="of-field">
            <p class="of-label" id="amt-label">Choose an amount</p>
            <div class="of-chips" role="radiogroup" aria-labelledby="amt-label">
              {amounts.map((a) => (
                <label class="of-chip"><input type="radio" name="preset" value={a} checked={a === 50} /><span>GH₵ {a}</span></label>
              ))}
              <label class="of-chip"><input type="radio" name="preset" value="other" /><span>Other</span></label>
            </div>
          </div>
          <div class="of-field" id="g-other-wrap" hidden>
            <label for="g-other">Your amount (GH₵)</label>
            <input id="g-other" type="number" inputmode="numeric" min="5" max="50000" step="1" placeholder="e.g. 75" />
          </div>
          <div class="of-field"><label for="g-name">Your name <span class="of-opt">(optional)</span></label><input id="g-name" name="name" autocomplete="name" maxlength="120" /></div>
          <div class="of-field"><label for="g-email">Email</label><input id="g-email" name="email" type="email" autocomplete="email" required maxlength="200" /><p class="of-hint">Paystack sends your receipt here.</p></div>
          <div class="of-field"><label for="g-msg">Message <span class="of-opt">(optional)</span></label><textarea id="g-msg" name="message" rows="2" maxlength="500"></textarea></div>
          <label class="of-check"><input type="checkbox" id="g-anon" /><span>Give anonymously</span></label>
          <p class="of-error" id="g-error" role="alert" hidden></p>
          <button class="button give__btn of-button-wide" type="submit" id="g-btn">Give GH₵ 50</button>
          <p class="of-lock"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Mobile Money or card, secured by Paystack</p>
        </form>
        <details class="give__bank">
          <summary>Prefer a bank transfer?</summary>
          <dl>
            <div><dt>Bank</dt><dd>{bank.bankName}, {bank.branch} branch</dd></div>
            <div><dt>Account name</dt><dd>{bank.accountName}</dd></div>
            <div><dt>Account number</dt><dd class="give__num">{bank.accountNumber}</dd></div>
            <div><dt>Reference</dt><dd>Donation</dd></div>
            <div><dt>SWIFT (from abroad)</dt><dd>{bank.swift}</dd></div>
          </dl>
        </details>
        <p class="give__note">
          Every gift is acknowledged. Prefer to give another way, or sponsor a full programme? <a href={site.whatsapp}>WhatsApp us</a>
          or email <a href="mailto:info@jaytech9.com?subject=Donation">info@jaytech9.com</a>. Donations are not refundable.
        </p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .donate {
    align-items: start;
    gap: 3rem 5rem;
    display: grid;
  }
  .donate h2 {
    font-size: var(--step-2);
    margin-bottom: 1.5rem;
  }
  .uses {
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .give {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    border: 1px solid #e3e9e5;
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }
  .give h2 { margin-bottom: 1rem; }
  .give__raised { margin: -0.25rem 0 1.25rem; padding: 0.65rem 0.9rem; border-radius: 12px; background: #fff0f0; color: #9b1c22; font-weight: 600; }
  .give__raised[hidden], #g-other-wrap[hidden] { display: none; }
  .give__btn { background: #ff5a5f; border-color: #ff5a5f; font-weight: 700; min-height: 3.25rem; margin-top: 0.5rem; }
  .give__btn:hover { background: #e8434a; border-color: #e8434a; }
  .give .of-chip input:checked + span { background: #ff5a5f; border-color: #ff5a5f; }
  .give { border-top: 6px solid #ff5a5f; }
  .give__bank { margin-top: 1.25rem; border: 1px solid var(--line); border-radius: 14px; padding: 0.2rem 0.9rem; }
  .give__bank summary { cursor: pointer; padding: 0.65rem 0; font-weight: 600; }
  .give__bank dl { margin: 0.2rem 0 0.8rem; display: grid; gap: 0.45rem; }
  .give__bank dl div { display: flex; justify-content: space-between; gap: 1rem; }
  .give__bank dt { color: var(--ink-soft); font-size: var(--step--1); }
  .give__bank dd { margin: 0; font-weight: 600; text-align: right; }
  .give__num { font-variant-numeric: tabular-nums; user-select: all; }
  .give__options p {
    color: var(--ink-soft);
  }
  .give__options .button {
    margin-top: 1rem;
  }
  .give__options .button-row .button {
    margin-top: 0;
  }
  .momo {
    gap: 1rem;
    margin: 0;
    display: grid;
  }
  .momo dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .momo dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
  }
  .momo__number {
    font-size: var(--step-1);
    font-variant-numeric: tabular-nums;
    user-select: all;
  }
  .give__note {
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-top: 1.75rem;
    padding-top: 1.25rem;
  }
  @media (width>=56rem) {
    .donate {
      grid-template-columns: 1.2fr 1fr;
    }
    .give {
      position: sticky;
      top: 6.5rem;
    }
  }
  /* Header photo: farmers in a maize field behind the title, under a dark brand-blue overlay
     so the words lead. Photo: Alex Gamaliel on Pexels (free licence). */
  .donate-hero {
    isolation: isolate;
    min-height: clamp(22rem, 55vh, 32rem);
    display: flex;
    align-items: center;
    background: #06223a;
  }
  .donate-hero__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }
  .donate-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, #04182bf0 0%, #06264acc 45%, #06264a80 80%, #06264a66 100%),
      linear-gradient(to top, #06223a 0%, #06223a00 45%);
  }
  .donate-hero__content {
    position: relative;
  }
  @media (width < 48rem) {
    .donate-hero::before {
      background: linear-gradient(180deg, #04182be6 0%, #06264ad9 60%, #06223a 100%);
    }
  }
  /* Wide screens: mirror the photo so the farmers stand to the right of the text. */
  @media (width >= 48rem) {
    .donate-hero__img {
      transform: scaleX(-1);
      object-position: center 50%;
    }
  }
  .donate-hero h1 {
    max-width: 16ch;
    text-wrap: balance;
    text-shadow: 0 2px 24px #0006;
  }
  .donate-hero .lede {
    color: #d9e8f2;
    max-width: 36rem;
  }
</style>

<script>
  const form = document.getElementById('give-form') as HTMLFormElement;
  const btn = document.getElementById('g-btn') as HTMLButtonElement;
  const other = document.getElementById('g-other') as HTMLInputElement;
  const otherWrap = document.getElementById('g-other-wrap')!;
  const err = document.getElementById('g-error')!;
  const presets = Array.from(form.querySelectorAll<HTMLInputElement>('input[name=preset]'));

  const amount = () => {
    const p = presets.find((r) => r.checked)?.value;
    return p === 'other' ? Math.round(Number(other.value)) : Number(p);
  };
  const label = () => { const a = amount(); btn.textContent = a >= 5 ? `Give GH₵ ${a.toLocaleString('en-GH')}` : 'Give now'; };
  const sync = () => { otherWrap.hidden = presets.find((r) => r.checked)?.value !== 'other'; label(); };
  presets.forEach((r) => r.addEventListener('change', () => { sync(); if (!otherWrap.hidden) other.focus(); }));
  other.addEventListener('input', label);

  // /donate/?amount=100 (from the home page band) picks that amount.
  const want = Number(new URLSearchParams(location.search).get('amount'));
  if (want >= 5) {
    const hit = presets.find((r) => Number(r.value) === want);
    if (hit) hit.checked = true; else { presets[presets.length - 1].checked = true; other.value = String(Math.round(want)); }
  }
  sync();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    const a = amount();
    const email = (document.getElementById('g-email') as HTMLInputElement).value.trim();
    const show = (m: string) => { err.textContent = m; err.hidden = false; };
    if (!(a >= 5 && a <= 50000)) return show('Please choose an amount between GH₵ 5 and GH₵ 50,000.');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return show('Please add your email so Paystack can send your receipt.');
    btn.classList.add('is-busy'); btn.textContent = 'Opening secure checkout…';
    try {
      const res = await fetch('/api/donate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({
        amount: a, email,
        name: (document.getElementById('g-name') as HTMLInputElement).value,
        message: (document.getElementById('g-msg') as HTMLTextAreaElement).value,
        anonymous: (document.getElementById('g-anon') as HTMLInputElement).checked,
      }) });
      const body = await res.json().catch(() => ({}));
      if (!res.ok || !body.url) throw new Error(body.error || 'Something went wrong. Please try again.');
      location.href = body.url;
    } catch (x) { show((x as Error).message); btn.classList.remove('is-busy'); label(); }
  });

  const raised = document.getElementById('give-raised')!;
  fetch('/api/stats').then((r) => r.json()).then((s) => {
    const d = s?.donations;
    if (!d || d.donors < 1) return;
    raised.textContent = `❤ GH₵ ${Math.round(d.total / 100).toLocaleString('en-GH')} raised from ${d.donors} supporter${d.donors > 1 ? 's' : ''}`;
    raised.hidden = false;
  }).catch(() => {});
</script>
