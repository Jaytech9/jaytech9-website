---
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__about">
      <p class="site-footer__name">{site.name}</p>
      <p>{site.tagline}</p>
      <p class="site-footer__legal">
        A trading name of {site.legalName}, {site.city}, {site.country}.
      </p>
    </div>
    <nav aria-label="Footer">
      <h2 class="site-footer__heading">Pages</h2>
      <ul>
        <li>
          <a href="/">Home</a>
        </li>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
        <li>
          <a href="/contact/">Contact</a>
        </li>
      </ul>
    </nav>
    <div>
      <h2 class="site-footer__heading">Contact</h2>
      <ul>
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
        </li>
        <li>
          <a href={site.whatsapp}>WhatsApp</a>
        </li>
        <li>
          {site.city}, {site.country}
        </li>
      </ul>
    </div>
    <div>
      <h2 class="site-footer__heading">Follow</h2>
      <ul>
        {site.social.map((s) => (
          <li>
            <a href={s.href} rel="me noopener">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap site-footer__base">
    <p>
      &copy; {year} {site.legalName}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--teal);
    color: #d3ebe8;
    font-size: var(--step--1);
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }
  .site-footer a {
    color: var(--paper);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--white);
    text-decoration: underline;
  }
  .site-footer__grid {
    grid-template-columns: 1fr;
    gap: 2.5rem;
    display: grid;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--paper);
    margin-bottom: 0.5rem;
  }
  .site-footer__about p + p {
    margin-top: 0.5rem;
  }
  .site-footer__about {
    max-width: 32ch;
  }
  .site-footer__legal {
    color: #a9d3ce;
  }
  .site-footer__heading {
    letter-spacing: 0;
    color: var(--white);
    margin-bottom: 0.9rem;
    font-size: 1rem;
  }
  .site-footer ul {
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .site-footer__base {
    padding-block: 1.5rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
    color: #a9d3ce;
    border-top: 1px solid #ffffff2e;
    margin-top: 3rem;
  }
  @media (width>=40rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (width>=64rem) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1.2fr 1fr;
    }
  }
</style>
