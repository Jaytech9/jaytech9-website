---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { footerLinks, footerServices, site } from '../data/site';
import { getSections } from '../lib/crm';
const sections = await getSections();
const links = footerLinks.filter((l) => !(l.href === '/blog/' && !sections.blog) && !(l.href === '/donate/' && !sections.donate));
import { glyphs } from '../data/brand-glyphs';
const year = new Date().getFullYear();

---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__about">
      <a class="site-footer__brand" href="/">
        <span class="site-footer__seal">
          <Image src={logo} alt="" width={40} height={40} densities={[1, 2, 3]} />
        </span>
        {site.name}
      </a>
      <p>{site.tagline}</p>
      <p class="site-footer__follow">Follow us</p>
      <ul class="site-footer__social">
        {site.social.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" aria-label={s.label} title={s.label}>
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d={glyphs[s.label]} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="site-footer__heading">Let’s connect</h2>
      <ul class="site-footer__contact">
        <li>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
            <rect x="2" y="4" width="20" height="16" rx="2" />
          </svg>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
        </li>
        <li>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d={glyphs.WhatsApp} />
          </svg>
          <a href={site.whatsapp}>Chat on WhatsApp</a>
        </li>
        <li>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>
            {site.city}, {site.country}
          </span>
        </li>
      </ul>
    </div>
    <nav aria-label="Useful links">
      <h2 class="site-footer__heading">Useful links</h2>
      <ul>
        {links.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div>
      <h2 class="site-footer__heading">Our services</h2>
      <ul>
        {footerServices.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap">
    <div class="site-footer__app" id="get-app" hidden>
      <img src="/icon-192.png" alt="" width="48" height="48" loading="lazy" />
      <div class="site-footer__app-text">
        <strong>Get the JayTech9 app</strong>
        <span>Opens from your home screen, loads fast and uses little data.</span>
        <span class="site-footer__app-tip" id="get-app-tip" hidden>On iPhone: tap the Share button <span aria-hidden="true">⎙</span>, then “Add to Home Screen”.</span>
      </div>
      <button type="button" class="site-footer__app-btn" id="get-app-btn">Get the app</button>
    </div>
  </div>
  <div class="site-footer__base">
    <div class="wrap site-footer__base-inner">
      <p>
        &copy; {year} {site.legalName}. <span class="nowrap">All rights reserved.</span>
      </p>
      <p><a href="/terms/">Terms</a> · <a href="/privacy/">Privacy policy</a></p>
    </div>
  </div>
</footer>

<script>
  // "Get the app": Android and computers (Chrome, Edge, Samsung) get the browser's install prompt;
  // iPhone shows how to add it from Safari's Share menu. Hidden once the site is installed.
  const box = document.getElementById('get-app');
  const btn = document.getElementById('get-app-btn');
  const tip = document.getElementById('get-app-tip');
  const w = window as Window & { __jt9Install?: Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: string }> } };
  const installed = matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone;
  const ios = /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const show = () => { if (box && !installed) box.hidden = false; };
  if (ios) show();
  if (w.__jt9Install) show();
  document.addEventListener('jt9-install', show);
  window.addEventListener('appinstalled', () => { if (box) box.hidden = true; });
  btn?.addEventListener('click', async () => {
    const e = w.__jt9Install;
    if (e) {
      await e.prompt();
      const { outcome } = await e.userChoice;
      if (outcome === 'accepted' && box) box.hidden = true;
      w.__jt9Install = undefined;
    } else if (tip) {
      tip.hidden = !tip.hidden;
    }
  });
</script>

<style>
  .site-footer__app {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, #0068a133, #3cc64a26);
    border: 1px solid #ffffff1f;
  }
  .site-footer__app[hidden] {
    display: none;
  }
  .site-footer__app img {
    border-radius: 12px;
    flex: none;
  }
  .site-footer__app-text {
    display: grid;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }
  .site-footer__app-text strong {
    color: var(--white);
  }
  .site-footer__app-text span {
    color: #c9d6df;
    font-size: 0.9rem;
  }
  .site-footer__app-text .site-footer__app-tip {
    color: #8fe070;
  }
  .site-footer__app-btn {
    flex: none;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    background: #8fe070;
    border-radius: 999px;
    padding: 0.7rem 1.2rem;
    min-height: 2.75rem;
  }
  .site-footer__app-btn:hover {
    background: var(--white);
  }
  .site-footer {
    background: var(--ink);
    color: #e6edf2;
    border-top: 4px solid var(--green);
    font-size: 1rem;
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }
  .site-footer a {
    color: var(--white);
    text-decoration: none;
    transition: color 0.2s;
  }
  .site-footer a:hover {
    color: #8fe070;
    text-decoration: underline;
  }
  /* Phones: brand and contact full width, the two short link lists side by side. */
  .site-footer__grid {
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 1.5rem;
    display: grid;
  }
  .site-footer__grid > :nth-child(-n + 2) {
    grid-column: 1 / -1;
  }
  .site-footer__about {
    max-width: 34ch;
  }
  .site-footer__brand {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    display: inline-flex;
  }
  .site-footer__brand:hover {
    color: var(--white);
    text-decoration: none;
  }
  .site-footer__seal {
    background: var(--white);
    border-radius: 50%;
    flex: none;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
  }
  .site-footer__follow {
    color: var(--white);
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .site-footer__heading {
    letter-spacing: 0;
    color: var(--white);
    font-size: 1.125rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    position: relative;
  }
  .site-footer__heading:after {
    content: '';
    background: var(--green);
    border-radius: 2px;
    width: 2.25rem;
    height: 3px;
    position: absolute;
    bottom: 0;
    left: 0;
  }
  .site-footer ul {
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .site-footer .site-footer__social {
    flex-wrap: wrap;
    gap: 0.75rem;
    display: flex;
  }
  .site-footer__social a {
    background: #ffffff1f;
    border-radius: 50%;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  .site-footer__social a:hover {
    background: var(--white);
    color: var(--ink);
    transform: translateY(-2px);
  }
  .site-footer__contact li {
    align-items: center;
    gap: 0.75rem;
    display: flex;
  }
  .site-footer__contact svg {
    color: #8fe070;
    flex: none;
  }
  .site-footer__base {
    background: #0b1e2b;
    padding-block: 1.25rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .site-footer__base-inner a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .site-footer__base-inner {
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    display: flex;
  }
  .nowrap {
    white-space: nowrap;
  }

  /* Phones: one centred column for the brand, a tidy contact card, two even link columns, centred base. */
  @media (width<40rem) {
    .site-footer {
      padding-top: 2.75rem;
    }
    .site-footer__grid {
      gap: 2.25rem 1rem;
    }
    .site-footer__about {
      max-width: none;
      text-align: center;
    }
    .site-footer__brand {
      flex-direction: column;
      gap: 0.6rem;
      margin-bottom: 0.75rem;
    }
    .site-footer__about > p:not(.site-footer__follow) {
      color: #c9d6df;
      max-width: 30ch;
      margin-inline: auto;
      font-size: 0.975rem;
    }
    .site-footer__follow {
      color: #9fb2c0;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.75rem;
      margin-top: 1.25rem;
      margin-bottom: 0.6rem;
    }
    .site-footer .site-footer__social {
      justify-content: center;
    }
    .site-footer__heading {
      text-align: center;
      font-size: 1rem;
      margin-bottom: 1rem;
    }
    .site-footer__heading:after {
      left: 50%;
      transform: translateX(-50%);
    }
    .site-footer .site-footer__contact {
      background: #ffffff0d;
      border: 1px solid #ffffff17;
      border-radius: 1rem;
      padding: 0.35rem 1.1rem;
    }
    .site-footer .site-footer__contact {
      gap: 0;
    }
    .site-footer__app {
      flex-wrap: wrap;
    }
    .site-footer__app-btn {
      width: 100%;
    }
    .site-footer__contact li {
      min-height: 3rem;
      padding-block: 0.4rem;
    }
    .site-footer__contact li + li {
      border-top: 1px solid #ffffff14;
    }
    /* Phones: the bottom Menu already holds these links, so hide them here.
       Services stay, full width in two neat columns. */
    .site-footer__grid > nav {
      display: none;
    }
    .site-footer__grid > :nth-child(4) {
      grid-column: 1 / -1;
      text-align: center;
    }
    .site-footer .site-footer__grid > :nth-child(4) ul {
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem 0.75rem;
      text-align: left;
      font-size: 0.875rem;
      background: #ffffff0d;
      border: 1px solid #ffffff17;
      border-radius: 1rem;
      padding: 1rem 0.9rem;
    }
    .site-footer__grid > :nth-child(4) li {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      white-space: nowrap;
      min-width: 0;
    }
    .site-footer__grid > :nth-child(4) li:before {
      content: '';
      flex: none;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #8fe070;
    }
    .site-footer__grid > :nth-child(4) a {
      color: #d5e0e8;
    }
    .site-footer__base {
      margin-top: 2.5rem;
    }
    .site-footer__base-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      font-size: 0.875rem;
      color: #9fb2c0;
      gap: 0.35rem;
    }
    .site-footer__base-inner p {
      margin: 0;
    }
  }

  /* Very narrow phones: one column so no service name gets cut. */
  @media (width<23.5rem) {
    .site-footer .site-footer__grid > :nth-child(4) ul {
      grid-template-columns: 1fr;
    }
  }

  @media (width>=40rem) {
    .site-footer__grid > :nth-child(-n + 2) {
      grid-column: auto;
    }
  }
  @media (width>=64rem) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1.2fr 0.8fr 1.1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer__social a:hover {
      transform: none;
    }
  }
</style>
