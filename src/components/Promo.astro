---
// Large banner cards that slide automatically (home page highlights, services header).
// App-style (like SSNIT Mobile): a centred card with its neighbours peeking in, a short pause on each card,
// then a smooth glide to the next, looping forward for ever. Swipe or tap the dots. Hover, focus or a touch
// pauses it; it stays still for anyone who has "reduce motion" switched on.
import Icon from './Icon.astro';

interface Slide {
  tag: string;
  icon: string;
  tone: 'ink' | 'blue' | 'green' | 'teal';
  before: string;
  highlight: string;
  after: string;
  sub: string;
  cta: string;
  href: string;
  art: string;
  image?: { src: string; alt: string };
}
interface Props {
  slides: Slide[];
  label: string;
  class?: string;
}
const { slides, label, class: className } = Astro.props;
---

<div class:list={['promo', className]} role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="promo__track" tabindex="0">
    {slides.map((s, i) => (
      <article class={`promo__slide promo__slide--${s.tone}${i === 0 ? ' is-active' : ''}`} aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
        <div class="promo__text">
          <h2 class="promo__title">
            {s.before}
            <em>{s.highlight}</em>
            {s.after}
          </h2>
          <p class="promo__sub">{s.sub}</p>
          <a class="promo__link" href={s.href}>
            {s.cta}
            <Icon name="arrow" size={16} />
          </a>
        </div>
        {s.image ? <img class="promo__art promo__img" src={s.image.src} alt={s.image.alt} loading="lazy" /> : <div class="promo__art" set:html={s.art} />}
        <span class="promo__tag">
          <Icon name={s.icon as any} size={14} />
          {s.tag}
        </span>
      </article>
    ))}
  </div>
  <div class="promo__controls">
    <div class="promo__dots">
      {slides.map((s, i) => (
        <button type="button" class="promo__dot" aria-label={`Show slide ${i + 1}: ${s.tag}`} aria-current={i === 0 ? 'true' : undefined} />
      ))}
    </div>
  </div>
</div>

<script is:inline>
  // Each card stays 3.5s, then the row glides left to the next card. A copy of the first card sits after
  // the last (and a copy of the last before the first), so the loop always moves forward without rewinding.
  (function () {
    var DELAY = 3500;
    var motionOK = matchMedia('(prefers-reduced-motion: no-preference)').matches;
    document.querySelectorAll('.promo:not([data-ready])').forEach(function (root) {
      root.setAttribute('data-ready', '');
      var track = root.querySelector('.promo__track');
      var real = Array.prototype.slice.call(track.children);
      var n = real.length;
      var dots = Array.prototype.slice.call(root.querySelectorAll('.promo__dot'));
      if (n > 1) {
        var headCopy = real[n - 1].cloneNode(true);
        var tailCopy = real[0].cloneNode(true);
        [headCopy, tailCopy].forEach(function (c) {
          c.classList.remove('is-active');
          c.setAttribute('aria-hidden', 'true');
          c.setAttribute('inert', '');
          c.removeAttribute('aria-label');
          c.removeAttribute('aria-roledescription');
        });
        track.insertBefore(headCopy, real[0]);
        track.appendChild(tailCopy);
      }
      var all = Array.prototype.slice.call(track.children);
      var offset = n > 1 ? 1 : 0;
      var index = offset, timer = null, resumeTimer = null, settleTimer = null;
      var hovering = false, interacting = false;

      function centre(el) { return el.offsetLeft - (track.clientWidth - el.clientWidth) / 2; }
      function jump(i) { track.scrollTo({ left: centre(all[i]), behavior: 'auto' }); }
      function glide(i) { track.scrollTo({ left: centre(all[i]), behavior: motionOK ? 'smooth' : 'auto' }); }
      function realOf(i) { return ((i - offset) % n + n) % n; }

      function setActive(i) {
        index = i;
        var r = realOf(i);
        all.forEach(function (s, j) { s.classList.toggle('is-active', j === i); });
        dots.forEach(function (d, j) {
          if (j === r) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
        });
      }
      // After the glide lands on a copy, swap to the real card at the same spot, invisibly.
      function settle() {
        if (n < 2) return;
        if (index === 0) { jump(n); setActive(n); }
        else if (index === n + 1) { jump(1); setActive(1); }
      }
      function canPlay() { return motionOK && n > 1 && !hovering && !interacting && !document.hidden; }
      function schedule() {
        clearTimeout(timer);
        if (canPlay()) timer = setTimeout(function () { glide(index + 1); }, DELAY);
      }
      function holdThenResume() {
        interacting = true;
        clearTimeout(timer);
        clearTimeout(resumeTimer);
        resumeTimer = setTimeout(function () { interacting = false; schedule(); }, 6000);
      }

      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { setActive(all.indexOf(e.target)); schedule(); }
            });
          },
          { root: track, threshold: 0.6 },
        );
        all.forEach(function (s) { io.observe(s); });
      }
      track.addEventListener('scroll', function () {
        clearTimeout(settleTimer);
        settleTimer = setTimeout(settle, 120);
      }, { passive: true });
      window.addEventListener('resize', function () { jump(index); });

      dots.forEach(function (d, i) {
        d.addEventListener('click', function () { holdThenResume(); glide(i + offset); });
      });
      root.addEventListener('mouseenter', function () { hovering = true; clearTimeout(timer); });
      root.addEventListener('mouseleave', function () { hovering = false; schedule(); });
      root.addEventListener('focusin', function () { hovering = true; clearTimeout(timer); });
      root.addEventListener('focusout', function () { hovering = false; schedule(); });
      ['pointerdown', 'touchstart', 'wheel'].forEach(function (ev) {
        track.addEventListener(ev, holdThenResume, { passive: true });
      });
      document.addEventListener('visibilitychange', schedule);

      jump(offset);
      setActive(offset);
      schedule();
    });
  })();
</script>

<style>
  /* Banner carousel */
  .promo {
    min-width: 0;
    margin-inline: calc(-1 * var(--gutter));
  }
  .promo__track {
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    grid-auto-columns: 84%;
    grid-auto-flow: column;
    gap: 0.6rem;
    padding: 0.25rem 8% 1.25rem;
    margin-bottom: -0.75rem;
    display: grid;
    overflow-x: auto;
  }
  .promo__track::-webkit-scrollbar {
    display: none;
  }
  .promo__track:focus-visible {
    outline-offset: -3px;
  }
  .promo__slide {
    scroll-snap-align: center;
    border-radius: var(--radius-lg);
    color: var(--white);
    min-height: 12.5rem;
    box-shadow: 0 12px 22px -14px #10293a99;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem 1rem 2.75rem 1.25rem;
    display: grid;
    position: relative;
    overflow: hidden;
  }
  .promo__slide--ink {
    background: linear-gradient(135deg, #10293a 0%, #1d4660 100%);
  }
  .promo__slide--blue {
    background: linear-gradient(135deg, #00446b 0%, #0a7bb8 100%);
  }
  .promo__slide--green {
    background: linear-gradient(135deg, #154f12 0%, #2a8a1c 100%);
  }
  .promo__slide--teal {
    background: linear-gradient(135deg, #0a4f52 0%, #12857c 100%);
  }
  .promo__slide--green .promo__title em {
    color: #c9f5b5;
  }
  .promo__text {
    flex-direction: column;
    gap: 0.5rem;
    display: flex;
  }
  .promo__title {
    letter-spacing: -0.025em;
    font-size: clamp(1.25rem, 0.95rem + 1.4vw, 2rem);
    font-weight: 700;
    line-height: 1.12;
  }
  .promo__title em {
    color: var(--accent);
    font-style: normal;
  }
  .promo__sub {
    color: #d5e2ea;
    font-size: 0.875rem;
    line-height: 1.4;
    display: none;
  }
  .promo__link {
    color: var(--white);
    font-size: 0.875rem;
    font-weight: 600;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    text-decoration: none;
    display: inline-flex;
  }
  .promo__link:after {
    content: '';
    z-index: 2;
    border-radius: var(--radius-lg);
    position: absolute;
    inset: 0;
  }
  .promo__slide {
    isolation: isolate;
  }
  .promo__slide:has(.promo__link:hover) .promo__link {
    color: var(--white);
    text-decoration: underline;
  }
  .promo__slide:has(.promo__link:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  .promo__link:focus-visible {
    outline: none;
  }
  .promo__art {
    align-self: center;
  }
  .promo__img {
    border-radius: 12px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    width: 100%;
    max-width: 15rem;
    margin-left: auto;
  }
  .promo__art :global(svg) {
    width: 100%;
    max-width: 15rem;
    margin-left: auto;
    filter: drop-shadow(0 10px 14px #0000004d);
  }
  .promo__tag {
    background: var(--accent);
    color: var(--ink);
    border-radius: 999px;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-flex;
    position: absolute;
    bottom: 0.9rem;
    left: 1.25rem;
  }
  .promo__controls {
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    display: flex;
  }
  .promo__dots {
    display: flex;
  }
  /* Dots: small and calm, like an app. The current card's dot is dark; 24px tap target. */
  .promo__dot {
    cursor: pointer;
    background: none;
    border: 0;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    display: grid;
  }
  .promo__dot:before {
    content: '';
    border-radius: 50%;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--brand);
    opacity: 0.45;
    transition:
      opacity 0.3s ease,
      background-color 0.3s ease;
  }
  .promo__dot[aria-current='true']:before {
    background: var(--ink);
    opacity: 1;
  }
  /* On a blue background (page headers) the dots switch to white, with green for the current card. */
  .promo--on-brand .promo__dot:before {
    background: var(--white);
    opacity: 0.55;
  }
  .promo--on-brand .promo__dot[aria-current='true']:before {
    background: var(--accent);
    opacity: 1;
  }
  /* Card change: the incoming card settles to full size while its words rise in; neighbours rest slightly back. */
  .promo__slide {
    transition:
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.6s ease;
  }
  .promo__slide:not(.is-active) {
    opacity: 0.85;
    transform: scale(0.97);
  }
  .promo__text > *,
  .promo__tag {
    transition:
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.7s ease;
  }
  .promo__slide:not(.is-active) .promo__text > *,
  .promo__slide:not(.is-active) .promo__tag {
    opacity: 0.4;
    transform: translateY(10px);
  }
  .promo__slide.is-active .promo__text > :nth-child(2) {
    transition-delay: 0.08s;
  }
  .promo__slide.is-active .promo__text > :nth-child(3) {
    transition-delay: 0.16s;
  }
  @media (prefers-reduced-motion: reduce) {
    .promo__slide:not(.is-active),
    .promo__slide:not(.is-active) .promo__text > *,
    .promo__slide:not(.is-active) .promo__tag {
      opacity: 1;
      transform: none;
    }
  }
  @media (width>=30rem) {
    .promo__sub {
      display: block;
    }
    .promo__slide {
      grid-template-columns: 1.15fr 1fr;
    }
  }
  @media (width>=48rem) {
    .promo__track {
      grid-auto-columns: 80%;
      padding-inline: 10%;
    }
    .promo__slide {
      min-height: 15rem;
      padding: 2rem 1.5rem 3.25rem 2rem;
    }
    .promo__tag {
      left: 2rem;
      bottom: 1.25rem;
    }
  }
  @media (width>=64rem) {
    .promo {
      margin-inline: 0;
    }
    .promo__track {
      grid-auto-columns: 88%;
      padding: 0 6% 1.25rem;
      gap: 0.75rem;
    }
    .promo__slide {
      min-height: 21rem;
      padding: 2.5rem 2rem 3.75rem 2.5rem;
    }
    .promo__tag {
      left: 2.5rem;
      bottom: 1.5rem;
    }
  }
</style>
