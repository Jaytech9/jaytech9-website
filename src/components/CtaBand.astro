---
// The closing call-to-action shown at the foot of most pages.
// One component, so every page gets the same design. Pass a page-specific heading and text.
// Left: heading, buttons and promises. Right: every way to reach us, so visitors never have to look.
import Icon from './Icon.astro';
import { site } from '../data/site';
import { glyphs } from '../data/brand-glyphs';

interface Props {
  heading?: string;
  text?: string;
  highlight?: string; // optional second line of the heading, shown in brand green
}
const {
  heading = 'Tell us what slows your business down',
  text = 'Book a free 30-minute call. We’ll listen, then send a clear quote.',
  highlight,
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-heading">
  <div class="wrap">
    <div class="cta__panel">
      <div class="cta__text">
        <h2 id="cta-heading">
          {heading}
          {highlight && <span class="cta__hl">{highlight}</span>}
        </h2>
        <p class="cta__lead">{text}</p>
        <div class="cta__actions">
          <a class="cta__btn cta__btn--primary" href="/book/">
            Book a free call
            <Icon name="arrow" size={18} />
          </a>
          <a class="cta__btn cta__btn--ghost" href={site.whatsapp} rel="noopener">
            <Icon name="message" size={18} />
            Chat on WhatsApp
          </a>
        </div>
      </div>

      <ul class="cta__contacts" aria-label="Contact details">
        <li>
          <a href={`tel:${site.phone}`}>
            <span class="cta__ic"><Icon name="headset" size={20} /></span>
            <span><small>Call us</small><strong>{site.phoneDisplay}</strong></span>
          </a>
        </li>
        <li>
          <a href={site.whatsapp} rel="noopener">
            <span class="cta__ic cta__ic--wa">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d={glyphs.WhatsApp} /></svg>
            </span>
            <span><small>WhatsApp</small><strong>Chat with us</strong></span>
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>
            <span class="cta__ic"><Icon name="mail" size={20} /></span>
            <span><small>Email</small><strong>{site.email}</strong></span>
          </a>
        </li>
        <li>
          <span class="cta__row">
            <span class="cta__ic"><Icon name="pin" size={20} /></span>
            <span><small>Based in</small><strong>{site.city}, {site.country} · Worldwide</strong></span>
          </span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  /* Deep green at the top fading through teal into navy, a soft blue glow low on the right,
     and a teal disc tucked into the top-left corner. */
  .cta__panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(4rem, 7vw, 5rem) clamp(1.5rem, 5vw, 3.25rem) clamp(1.5rem, 5vw, 3.25rem);
    border-radius: calc(var(--radius-lg) + 6px);
    background:
      radial-gradient(ellipse 45% 55% at 78% 72%, #11608acc 0%, #0b4a6e66 45%, transparent 75%),
      linear-gradient(172deg, #087d18 0%, #077226 22%, #08594a 45%, #0a3a4f 68%, #0a2638 85%, #08161d 100%);
    color: var(--white);
    box-shadow: 0 30px 60px -30px #0a263880;
  }
  .cta__panel::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: clamp(7rem, 12vw, 10rem);
    aspect-ratio: 1;
    left: -4rem;
    top: -4.5rem;
    border-radius: 50%;
    background: #06a0a0;
    box-shadow: 14px 16px 34px #000000b3;
  }
  @media (width >= 56rem) {
    .cta__panel {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .cta h2 {
    margin: 0;
    max-width: 16ch;
    color: var(--white);
    text-wrap: balance;
  }
  /* Second line of the heading: brand green so the invitation stands out. */
  .cta__hl {
    display: block;
    margin-top: 0.15em;
    color: var(--accent);
  }
  .cta h2:has(.cta__hl) {
    max-width: 20ch;
  }
  .cta__lead {
    margin: 1rem 0 1.75rem;
    max-width: 30rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: #dcecf5;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s var(--card-ease, ease),
      background-color 0.2s,
      box-shadow 0.2s;
  }
  .cta__btn--primary {
    background: var(--white);
    color: var(--brand-deep);
    box-shadow: 0 10px 24px -12px #00000066;
  }
  .cta__btn--primary:hover {
    transform: translateY(-2px);
    color: var(--brand-deep);
  }
  .cta__btn--primary :global(svg) {
    transition: transform 0.2s;
  }
  .cta__btn--primary:hover :global(svg) {
    transform: translateX(3px);
  }
  .cta__btn--ghost {
    background: #ffffff1a;
    border: 1.5px solid #ffffff59;
    color: var(--white);
  }
  .cta__btn--ghost:hover {
    background: #ffffff2e;
    color: var(--white);
    transform: translateY(-2px);
  }
  .cta__btn:focus-visible,
  .cta__contacts a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  /* Contact cards */
  .cta__contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .cta__contacts a,
  .cta__row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    box-shadow: 0 10px 22px -16px #0000004d;
    transition: transform 0.2s var(--card-ease, ease);
  }
  .cta__contacts a:hover {
    transform: translateX(4px);
    color: var(--ink);
  }
  .cta__contacts small {
    display: block;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .cta__contacts strong {
    display: block;
    overflow-wrap: anywhere;
  }
  .cta__ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: #e6f1f8;
    color: var(--brand);
  }
  .cta__ic--wa {
    background: #e3f7e9;
    color: #1e7a3c;
  }
  @media (width < 30rem) {
    .cta__btn {
      flex: 1 1 100%;
    }
  }
</style>
