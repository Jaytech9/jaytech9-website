---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getSections } from '../lib/crm';

// App-style tab bar for phones and tablets. Hidden on wide screens, where the top bar has the full menu.
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// "Order" sits in the middle, raised in green: the easiest spot for a thumb on a phone.
const tabs = [
  { label: 'Home', href: '/', icon: 'home' },
  { label: 'Services', href: '/services/', icon: 'layers' },
  { label: 'Order', href: '/order/', icon: 'briefcase', main: true },
  { label: 'Products', href: '/products/', icon: 'package' },
] as const;

const allMore = [
  { label: 'Contact', href: '/contact/', icon: 'mail' },
  { label: 'Design gallery', href: '/design/', icon: 'brush' },
  { label: 'About us', href: '/about/', icon: 'info' },
  { label: 'Blog', href: '/blog/', icon: 'book' },
  { label: 'Careers', href: '/careers/', icon: 'users' },
  { label: 'Donate', href: '/donate/', icon: 'heart' },
  { label: 'Book a free call', href: '/book/', icon: 'rocket' },
  { label: 'Support', href: `mailto:${site.email}`, icon: 'headset' },
] as const;
const sections = await getSections();
const more = allMore.filter((m) => !(m.href === '/blog/' && !sections.blog) && !(m.href === '/donate/' && !sections.donate));
---

<nav class="tabbar" aria-label="App navigation">
  <ul class="tabbar__list">
    {tabs.map((t) => (
      <li>
        <a class:list={['tabbar__item', { 'tabbar__item--main': 'main' in t }]} href={t.href} aria-current={isCurrent(t.href) ? 'page' : undefined}>
          {'main' in t ? (
            <span class="tabbar__main"><Icon name={t.icon} size={24} strokeWidth={2} /></span>
          ) : (
            <Icon name={t.icon} size={22} strokeWidth={1.8} />
          )}
          <span>{t.label}</span>
        </a>
      </li>
    ))}
    <li>
      <details class="tabbar__more">
        <summary class="tabbar__item">
          <Icon name="menu" size={22} strokeWidth={1.8} />
          <span>Menu</span>
        </summary>
        <div class="sheet">
          <span class="sheet__grip" aria-hidden="true" data-grip></span>
          <ul class="sheet__grid">
            {more.map((m) => (
              <li>
                <a class="sheet__tile" href={m.href} aria-current={m.href.startsWith('/') && m.href !== '/book/' && isCurrent(m.href) ? 'page' : undefined}>
                  <Icon name={m.icon} size={24} strokeWidth={1.8} />
                  <span>{m.label}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="button sheet__chat" href={site.whatsapp}>
            <Icon name="chat" size={20} />
            Chat on WhatsApp
          </a>
        </div>
      </details>
    </li>
  </ul>
</nav>

<script>
  // Menu sheet: closes with a short slide-down (tap outside, Escape, the Menu tab again, or a swipe down).
  import { closeWithMotion, swipeToClose } from '../scripts/swipe';
  const more = document.querySelector<HTMLDetailsElement>('.tabbar__more');
  const sheet = more?.querySelector<HTMLElement>('.sheet');
  if (more && sheet) {
    const close = (focus = false) => {
      if (!more.open || more.classList.contains('is-closing')) return;
      closeWithMotion(more, () => { more.open = false; if (focus) more.querySelector('summary')?.focus(); }, 220);
    };
    more.querySelector('summary')?.addEventListener('click', (e) => { if (more.open) { e.preventDefault(); close(); } });
    // The dark backdrop is drawn by the menu itself, so a tap on it lands on the menu element: close then too.
    document.addEventListener('click', (e) => { if (more.open && (e.target === more || !more.contains(e.target as Node))) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(true); });
    swipeToClose(sheet, () => { more.open = false; });
  }
</script>

<style>
  .tabbar {
    z-index: 60;
    background: var(--ink);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    box-shadow: 0 -6px 20px #10293a33;
  }
  .tabbar__list {
    grid-template-columns: repeat(5, 1fr);
    max-width: 40rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .tabbar__item {
    color: #b9c7d1;
    cursor: pointer;
    min-height: 4rem;
    font-size: 0.75rem;
    font-weight: 500;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    text-decoration: none;
    display: flex;
    position: relative;
  }
  /* Raised green "Order" button in the middle. */
  .tabbar__item--main {
    color: var(--white);
    font-weight: 600;
  }
  .tabbar__main {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-top: -1.6rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
    box-shadow: 0 0 0 4px #10293a, 0 8px 18px #0006;
    transition: transform 0.16s var(--ease-out);
  }
  .tabbar__item--main:active .tabbar__main {
    transform: scale(0.92);
    transition-duration: 0.08s;
  }
  .tabbar__item {
    -webkit-tap-highlight-color: transparent;
  }
  .tabbar__item > :global(svg) {
    transition: transform 0.16s var(--ease-out);
  }
  .tabbar__item:active > :global(svg) {
    transform: scale(0.88);
    transition-duration: 0.08s;
  }
  .tabbar__item--main[aria-current='page']:before {
    display: none;
  }
  .tabbar__item::-webkit-details-marker {
    display: none;
  }
  .tabbar__item:hover {
    color: var(--white);
  }
  .tabbar__item[aria-current='page'],
  .tabbar__more[open] > .tabbar__item {
    color: var(--accent);
  }
  .tabbar__item[aria-current='page']:before {
    content: '';
    background: var(--accent);
    border-radius: 0 0 3px 3px;
    width: 1.75rem;
    height: 3px;
    position: absolute;
    top: 0;
  }
  .tabbar__more[open]:before {
    content: '';
    background: #10293a80;
    position: fixed;
    inset: 0;
    z-index: -1;
    animation: scrim-in 0.3s ease both;
  }
  .tabbar__more.is-closing:before {
    animation: scrim-out 0.22s ease both;
  }
  @keyframes scrim-in {
    from { opacity: 0; }
  }
  @keyframes scrim-out {
    to { opacity: 0; }
  }
  .sheet {
    background: var(--paper);
    border-radius: 24px 24px 0 0;
    padding: 0.75rem var(--gutter) 1.5rem;
    position: fixed;
    bottom: calc(4rem + env(safe-area-inset-bottom, 0px));
    left: 0;
    right: 0;
    box-shadow: 0 -12px 30px #10293a40;
    touch-action: none;
    animation: sheet-up 0.4s var(--ease-drawer) both;
  }
  .tabbar__more.is-closing .sheet {
    animation: sheet-down 0.22s ease-in both;
  }
  @keyframes sheet-up {
    from { transform: translateY(100%); }
  }
  @keyframes sheet-down {
    to { transform: translateY(100%); }
  }
  /* Tiles settle in one after another, just enough to feel alive. */
  .sheet__grid > li {
    animation: tile-in 0.35s var(--ease-out) both;
  }
  .sheet__grid > li:nth-child(2) { animation-delay: 20ms; }
  .sheet__grid > li:nth-child(3) { animation-delay: 40ms; }
  .sheet__grid > li:nth-child(4) { animation-delay: 60ms; }
  .sheet__grid > li:nth-child(5) { animation-delay: 80ms; }
  .sheet__grid > li:nth-child(6) { animation-delay: 100ms; }
  .sheet__grid > li:nth-child(7) { animation-delay: 120ms; }
  .sheet__grid > li:nth-child(n + 8) { animation-delay: 140ms; }
  @keyframes tile-in {
    from { opacity: 0; transform: translateY(8px); }
  }
  .sheet__grip {
    background: var(--line);
    border-radius: 3px;
    width: 2.5rem;
    height: 5px;
    margin: 0 auto 1rem;
    display: block;
    cursor: grab;
    /* A bigger invisible target so the grip is easy to catch with a thumb. */
    box-shadow: 0 0 0 14px transparent;
  }
  .sheet__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    max-width: 34rem;
    margin: 0 auto 1rem;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .sheet__tile {
    background: var(--white);
    border: var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--shadow-card);
    color: var(--ink);
    text-align: center;
    min-height: 5.75rem;
    padding: 0.75rem 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    display: flex;
  }
  .sheet__tile :global(svg) {
    color: var(--brand);
  }
  .sheet__tile[aria-current='page'] {
    color: var(--brand);
    box-shadow: var(--card-ring);
  }
  .sheet__chat {
    background: var(--accent-deep);
    border-color: var(--accent-deep);
    justify-content: center;
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    display: flex;
  }
  @media (width>=64rem) {
    .tabbar {
      display: none;
    }
  }
</style>
