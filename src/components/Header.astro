---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
import { getSections } from '../lib/crm';
const sections = await getSections();

const path = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---

<header class="app-bar">
  <div class="wrap app-bar__inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand__seal">
        <Image src={logo} alt="" width={30} height={30} densities={[1, 2, 3]} loading="eager" format="webp" />
      </span>
      <span class="brand__name">{site.name}</span>
    </a>
    <nav class="app-bar__nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current(item.href)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      {sections.donate && (
        <a class="app-bar__give" href="/donate/" aria-current={current('/donate/')}>
          <Icon name="heart" size={16} /> Donate
        </a>
      )}
      <a class="button app-bar__cta" href="/book/">
        Book a free call
      </a>
    </nav>
    {sections.donate && (
      <a class="app-bar__give app-bar__give--icon" href="/donate/" aria-label="Donate">
        <Icon name="heart" size={18} />
      </a>
    )}
    <a class="app-bar__chat" href={site.whatsapp} aria-label="Chat with us on WhatsApp">
      <Icon name="chat" size={20} />
    </a>
  </div>
</header>

<style>
  .app-bar {
    padding-top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: var(--brand);
    color: var(--white);
    position: sticky;
    top: 0;
  }
  .app-bar__inner {
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
    display: flex;
  }
  .brand {
    color: var(--white);
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    display: inline-flex;
  }
  .brand:hover {
    color: var(--white);
  }
  .brand__seal {
    background: var(--white);
    border-radius: 50%;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    box-shadow: 0 2px 8px #0003;
  }
  .brand__name {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    font-size: 1.375rem;
    font-weight: 700;
  }
  .app-bar__nav {
    align-items: center;
    gap: 1.75rem;
    display: none;
  }
  .app-bar__nav ul {
    gap: clamp(1rem, 1.6vw, 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
  }
  .app-bar__nav ul a {
    color: #e3f0f8;
    padding-block: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    position: relative;
  }
  .app-bar__nav ul a:hover,
  .app-bar__nav ul a[aria-current='page'] {
    color: var(--white);
  }
  .app-bar__nav ul a:after {
    content: '';
    background: var(--accent);
    border-radius: 2px;
    height: 3px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
    position: absolute;
    inset: auto 0 -2px;
  }
  .app-bar__nav ul a:hover:after,
  .app-bar__nav ul a[aria-current='page']:after {
    transform: scaleX(1);
  }
  .app-bar__cta {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
    min-height: 2.375rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .app-bar__cta:hover {
    background: var(--white);
    border-color: var(--white);
    color: var(--ink);
  }
  /* Donate: a warm red pill so it stands apart from the blue bar and the green "Book" button. */
  .app-bar__give {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.375rem; padding: 0.45rem 1rem;
    border-radius: 980px; background: #ff5a5f; color: var(--white); font-size: 0.9375rem; font-weight: 600;
    text-decoration: none; transition: background-color 0.15s, transform 0.15s;
  }
  .app-bar__give:hover { background: #e8434a; color: var(--white); transform: translateY(-1px); }
  .app-bar__give :global(svg) { fill: currentColor; }
  .app-bar__give--icon { width: 2.75rem; height: 2.75rem; padding: 0; justify-content: center; border-radius: 50%; margin-left: auto; }
  .app-bar__chat {
    background: #ffffff26;
    color: var(--white);
    border-radius: 50%;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
  }
  .app-bar__chat:hover {
    background: var(--white);
    color: var(--brand);
  }
  @media (width>=64rem) {
    .app-bar__inner {
      min-height: 4.5rem;
    }
    .app-bar__nav {
      display: flex;
    }
    .app-bar__chat,
    .app-bar__give--icon {
      display: none;
    }
  }
</style>
