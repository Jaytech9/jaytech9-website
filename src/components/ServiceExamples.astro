---
// Under each service on the Services page: links to the products and projects that show it in action.
// Comes from the "service" field on each product, so new work appears here automatically.
import { getCollection } from 'astro:content';
import { getProjects, getSections, serviceIdFromTitle } from '../lib/crm';

interface Props {
  service: string;
  cta?: string;
  order?: string; // quick jobs: show "Order now" first (opens /order/ with this service)
}
const { service, cta = 'Book this service', order } = Astro.props;
const examples = (await getCollection('products', (p) => p.data.service === service)).sort(
  (a, b) => a.data.order - b.data.order,
);
const sections = await getSections();
// Projects you switch on in the CRM ("Show on the website") join the list for their service.
const projects = sections.service_examples
  ? (await getProjects()).filter((p) => p.service && serviceIdFromTitle[p.service] === service)
  : [];
const showExamples = sections.service_examples;
---

<div class="examples">
  {order ? (
    <div class="examples__actions">
      <a class="examples__book" href={`/order/?service=${order}`}>Order now</a>
      <a class="examples__talk" href={`/book/?service=${service}`}>Talk it through first</a>
    </div>
  ) : (
    <a class="examples__book" href={`/book/?service=${service}`}>{cta}</a>
  )}
  {
    service === 'design' ? (
      <>
        <p class="examples__label">See it in action</p>
        <ul class="examples__list">
          <li>
            <a href="/design/">
              Browse the design gallery <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </>
    ) : showExamples && examples.length + projects.length > 0 ? (
      <>
        <p class="examples__label">See it in action</p>
        <ul class="examples__list">
          {examples.map((e) => (
            <li>
              <a href={`/products/${e.id}/`}>
                {e.data.title}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
          {projects.map((p) => (
            <li>
              {p.live_url ? (
                <a href={p.live_url} rel="noopener" target="_blank">
                  {p.title}
                  <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="examples__project" title={p.summary ?? undefined}>
                  {p.title}
                  {p.outcome && <small>{p.outcome}</small>}
                </span>
              )}
            </li>
          ))}
        </ul>
      </>
    ) : (
      null
    )
  }
</div>

<style>
  .examples {
    margin-top: 1.25rem;
  }
  .examples__book {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-bottom: 1rem;
    padding: 0.5rem 1.2rem;
    border-radius: 999px;
    background: var(--brand);
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s, transform 0.2s;
  }
  .examples__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1rem;
  }
  .examples__actions .examples__book {
    margin-bottom: 0;
  }
  .examples__talk {
    font-weight: 600;
    color: var(--brand);
  }
  .examples__book:hover {
    background: var(--brand-deep);
    color: var(--white);
    transform: translateY(-2px);
  }
  .examples__book:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .examples__label {
    margin: 0 0 0.5rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .examples__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .examples__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: #e6f1f8;
    color: var(--brand-deep);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .examples__list a:hover {
    background: var(--brand);
    color: var(--white);
  }
  .examples__project {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--white);
    box-shadow: inset 0 0 0 1.5px #d6e0e7;
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.25;
  }
  .examples__project small {
    font-weight: 400;
    color: var(--ink-soft);
  }
</style>
