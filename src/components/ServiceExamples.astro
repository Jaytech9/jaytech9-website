---
// Under each service on the Services page: links to the products and projects that show it in action.
// Comes from the "service" field on each product, so new work appears here automatically.
import { getCollection } from 'astro:content';

interface Props {
  service: string;
}
const { service } = Astro.props;
const examples = (await getCollection('products', (p) => p.data.service === service)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<div class="examples">
  <a class="examples__book" href={`/book/?service=${service}`}>Book this service</a>
  {
    service === 'design' ? (
      <>
        <p class="examples__label">See it in action</p>
        <ul class="examples__list">
          <li>
            <a href="/design/">
              Browse the design gallery <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </>
    ) : examples.length > 0 ? (
      <>
        <p class="examples__label">See it in action</p>
        <ul class="examples__list">
          {examples.map((e) => (
            <li>
              <a href={`/products/${e.id}/`}>
                {e.data.title}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      null
    )
  }
</div>

<style>
  .examples {
    margin-top: 1.25rem;
  }
  .examples__book {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-bottom: 1rem;
    padding: 0.5rem 1.2rem;
    border-radius: 999px;
    background: var(--brand);
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s, transform 0.2s;
  }
  .examples__book:hover {
    background: var(--brand-deep);
    color: var(--white);
    transform: translateY(-2px);
  }
  .examples__book:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .examples__label {
    margin: 0 0 0.5rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .examples__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .examples__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: #e6f1f8;
    color: var(--brand-deep);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .examples__list a:hover {
    background: var(--brand);
    color: var(--white);
  }
</style>
